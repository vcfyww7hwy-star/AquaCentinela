//@version=6
// Trend & Setups v2 — trend-flow-suite (price overlay)
// Rebuilt from tests on about 1.7 million stock-days, 1999–2018 (docs/06_validation_lite.md):
//   Trend    The LONG-TERM (higher-timeframe) trend is the main readout. It did not predict returns, but standing
//            aside while it is Down cut portfolio drawdowns by a third or more at the same risk-adjusted return.
//            The chart's own trend state is shown for information only.
//   Setup D  Dip in a long-term uptrend (default). A short bounce (1–5 bars) is confirmed in the tests; as a complete
//            trade rule it is NOT confirmed. Treat it as a timing aid, not as a system.
//   B, R     Compression breakout and confirmed reversal: no edge in the tests; off by default.
//   Risk     Stops are stop orders (intrabar). Position size from account size and risk %, capped.
// Python twin: research/tfs/trend.py — same maths and state machines (tests: research/tests/test_trend.py).
// Strategy version: generated from this file by research/tools/build_strategy.py — do not edit it by hand.
// Personal research tool, not investment advice.
indicator("Trend & Setups v2", shorttitle = "T&S2", overlay = true, precision = 2, max_bars_back = 2000, max_labels_count = 500, max_lines_count = 100) // @header

// ───── Palette (Okabe-Ito, colour-blind safe) ─────
color C_UP    = #0072B2
color C_DN    = #D55E00
color C_NEU   = #999999
color C_ENTRY = #009E73
color C_EXIT  = #CC79A7
color C_VWAP  = #E69F00

string STOP_INTRA = "Stop order (intrabar)"
string STOP_CLOSE = "On the close"
int    DIP_LEN    = 5
float  SIG_CLIP   = 3.0

// ───── Shared core: twins of research/tfs/core.py ─────
ema1(float x, int n) =>
    float a = 2.0 / (n + 1)
    var float e = na
    e := na(e) ? x : na(x) ? e : a * x + (1.0 - a) * e
    e

rma1(float x, int n) =>
    float a = 1.0 / n
    var float e = na
    e := na(e) ? x : na(x) ? e : a * x + (1.0 - a) * e
    e

smooth2(float x, int n) =>
    ema1(ema1(x, n), n)

slotEwmaLagged(float x, int slot, int span) =>
    var array<float> st = array.new<float>()
    while array.size(st) <= slot
        array.push(st, na)
    float prev = array.get(st, slot)
    if barstate.isconfirmed and not na(x)
        float a = 2.0 / (span + 1)
        array.set(st, slot, na(prev) ? x : a * x + (1.0 - a) * prev)
    prev

// ───── Trend engine: twins of research/tfs/trend.py ─────
// EWMA variance of returns, value BEFORE this bar. After `span` bars each squared return is capped at
// (clip × sigma)², so one earnings gap cannot distort the estimate for months.
robustVarLagged(float r, int span, float clip) =>
    var float v = na
    var int   n = 0
    float prev = v
    if barstate.isconfirmed and not na(r)
        float r2 = r * r
        float a  = 2.0 / (span + 1)
        v := na(prev) or prev <= 0 ? r2 : (n < span or clip <= 0) ? a * r2 + (1.0 - a) * prev : a * math.min(r2, clip * clip * prev) + (1.0 - a) * prev
        n += 1
    prev

// Calibrated trend score: three EMA crossovers of log price, each divided by its exact standard deviation under a
// random walk, averaged and rescaled → N(0,1) when there is no trend (constants: trend.py pair_null_sd, composite_null_sd)
trendScore(float lp, int sigSpan) =>
    float sig = math.sqrt(robustVarLagged(lp - lp[1], sigSpan, SIG_CLIP))
    float x1  = ema1(lp, 8) - ema1(lp, 24)
    float x2  = ema1(lp, 16) - ema1(lp, 48)
    float x3  = ema1(lp, 32) - ema1(lp, 96)
    float z1  = sig > 0 ? x1 / (sig * 1.417891627264463) : na
    float z2  = sig > 0 ? x2 / (sig * 2.0013016597538043) : na
    float z3  = sig > 0 ? x3 / (sig * 2.82888744326575) : na
    (z1 + z2 + z3) / 3.0 / 0.9171347868042847

trendDir(float ts, float enterT, float exitT) =>
    var int d = 0
    if not na(ts)
        if ts >= enterT
            d := 1
        else if ts <= -enterT
            d := -1
        else if d == 1 and ts < exitT
            d := 0
        else if d == -1 and ts > -exitT
            d := 0
    d

// Value of the last COMPLETED bar of the requested timeframe (used with lookahead_on → no repainting)
htfTrend(int sigSpan, float enterT, float exitT) =>
    float ts = trendScore(math.log(close), sigSpan)
    int d = trendDir(ts, enterT, exitT)
    [ts[1], d[1]]

tfAtLeastChart(string tf) =>
    timeframe.in_seconds(tf) >= timeframe.in_seconds(timeframe.period) ? tf : timeframe.period

isChartTf(string tf) =>
    timeframe.in_seconds(tf) == timeframe.in_seconds(timeframe.period)

stateText(int d, float s, float strongT) =>
    d == 1 ? (s >= strongT ? "Strong up" : "Up") : d == -1 ? (s <= -strongT ? "Strong down" : "Down") : "Neutral"

stateColor(int d) =>
    d == 1 ? C_UP : d == -1 ? C_DN : C_NEU

// ───── Inputs ─────
string G_T = "Trend"
string ctxIn     = input.string("Auto", "Long-term trend timeframe", options = ["Auto", "60", "240", "D", "W", "M"], group = G_T,
     tooltip = "Auto: charts below 4h → Daily; 4h and Daily → Weekly; Weekly → Monthly. Tested combination: Daily chart with Weekly trend.")
string benchIn   = input.symbol("AMEX:SPY", "Benchmark (market trend and relative strength)", group = G_T)
int    sigSpan   = input.int(100, "Volatility span (bars)", minval = 10, group = G_T)
float  enterThr  = input.float(1.0, "Trend state: enter at |score| ≥", minval = 0.1, step = 0.1, group = G_T)
float  exitThr   = input.float(0.3, "Trend state: back to neutral below |score|", minval = 0.0, step = 0.1, group = G_T)
float  strongThr = input.float(2.0, "Strong trend at |score| ≥", minval = 0.5, step = 0.25, group = G_T)

string G_SET = "Setups (long side)"
bool   useD      = input.bool(true, "D — dip in a long-term uptrend", group = G_SET,
     tooltip = "Long-term trend Up and the 5-bar move at or below the threshold, on the first bar of the dip. Tests: a 1–5 bar bounce is confirmed; the complete trade rule is not.")
float  dipZ      = input.float(-1.5, "D: dip when the 5-bar move ≤ (σ)", maxval = -0.5, step = 0.25, group = G_SET)
float  dipStop   = input.float(2.0, "D: stop distance (ATR)", minval = 0.5, step = 0.25, group = G_SET)
bool   useB      = input.bool(false, "B — compression breakout (no edge in tests)", group = G_SET)
float  compRat   = input.float(0.8, "B: compression when ATR14 ≤ this × ATR100", step = 0.05, group = G_SET)
int    brkLen    = input.int(20, "B: breakout above the prior N-bar high", minval = 2, group = G_SET)
float  brkRvol   = input.float(1.5, "B: minimum relative volume", step = 0.1, group = G_SET)
bool   useR      = input.bool(false, "R — confirmed reversal, half size (negative in tests)", group = G_SET)
int    revLb     = input.int(20, "R: look-back for downtrend and oversold (bars)", minval = 2, group = G_SET)
float  revExt    = input.float(-2.0, "R: oversold when extension ≤ (ATR)", step = 0.25, group = G_SET)
bool   useMkt    = input.bool(false, "D and B need the market trend not down (untested)", group = G_SET)

string G_R = "Risk and exits"
string stopModeIn = input.string(STOP_INTRA, "Stops trigger", options = [STOP_INTRA, STOP_CLOSE], group = G_R,
     tooltip = "Stop order: exit when price touches the stop (at the open after a gap). In tests 1% of such trades lost more than 1.5R, against 5–9% with exits on the close.")
float  trailAtr  = input.float(3.0, "Trailing stop (ATR below the highest high since entry)", minval = 0.5, step = 0.25, group = G_R)
int    maxBars   = input.int(0, "Time exit after N bars (0 = off)", minval = 0, group = G_R)
float  stopBuf   = input.float(0.25, "B and R: stop buffer (ATR)", minval = 0.0, step = 0.05, group = G_R)
float  minStop   = input.float(1.0, "Minimum stop distance (ATR)", minval = 0.0, step = 0.25, group = G_R)
float  equityIn  = input.float(10000, "Account size", minval = 0, group = G_R)
float  riskPct   = input.float(1.0, "Risk per trade (%)", minval = 0.0, step = 0.25, group = G_R)
float  maxPosPct = input.float(25.0, "Largest position (% of account)", minval = 1.0, step = 5.0, group = G_R)
int    warmup    = input.int(200, "No signals before bar number", minval = 0, group = G_R)

string G_S = "Structure and display"
float  swingAtr   = input.float(2.0, "Swing size (ATR)", minval = 0.5, step = 0.25, group = G_S)
int    atrLen     = input.int(14, "ATR length", minval = 1, group = G_S)
int    baseWin    = input.int(50, "Baseline window (SMA-equivalent bars)", minval = 3, group = G_S)
bool   showSwings = input.bool(true, "Label swings (HH / HL / LH / LL)", group = G_S)
bool   showLevels = input.bool(true, "Show last swing high / low", group = G_S)
bool   showAvwap  = input.bool(false, "Show anchored VWAP from the last swing", group = G_S)
bool   showBreaks = input.bool(false, "Mark structure breaks against the chart trend", group = G_S)
bool   showCtxBg  = input.bool(true, "Shade the chart while the long-term trend is Down", group = G_S)
bool   showTradeLabels = input.bool(true, "Label entries and exits with details", group = G_S)
bool   showTable  = input.bool(true, "Show status table", group = G_S)
bool   colorBars  = input.bool(false, "Colour price bars by the long-term trend", group = G_S)

// ───── Core series ─────
bool  conf  = barstate.isconfirmed
float lp    = math.log(close)
float ts    = trendScore(lp, sigSpan)
int   dir   = trendDir(ts, enterThr, exitThr)
float tr    = na(close[1]) ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
float atr   = rma1(tr, atrLen)
float atrL  = rma1(tr, 100)
float base  = smooth2(close, math.floor((baseWin + 1) / 2.0))
float ext   = atr > 0 ? (close - base) / atr : na

// 5-bar move in risk units, with the same lagged volatility as the trend score
float sigR     = math.sqrt(robustVarLagged(lp - lp[1], sigSpan, SIG_CLIP))
float dipMove  = sigR > 0 ? (lp - lp[DIP_LEN]) / (sigR * math.sqrt(DIP_LEN)) : na
bool  inDip    = dipMove <= dipZ
bool  dipFirst = inDip and not inDip[1]

// Relative volume (per time-of-day slot intraday, 50 bars on D/W/M) — identical to the volume pane
var int slotCount = -1
slotCount := session.isfirstbar ? 0 : slotCount + 1
int   slot  = timeframe.isintraday ? slotCount : 0
int   nSpan = timeframe.isintraday ? 20 : 50
float ev    = slotEwmaLagged(volume, slot, nSpan)
float rvol  = ev > 0 ? volume / ev : na

// Benchmark: market trend and relative strength
float benchClose = request.security(benchIn, timeframe.period, close)
float mktTs  = trendScore(math.log(benchClose), sigSpan)
int   mktDir = trendDir(mktTs, enterThr, exitThr)
float rsTs   = trendScore(math.log(close / benchClose), sigSpan)
int   rsDir  = trendDir(rsTs, enterThr, exitThr)

// Long-term trend and the multi-timeframe table (last completed higher-timeframe bar)
string autoCtx = timeframe.isintraday ? (timeframe.in_seconds(timeframe.period) < 14400 ? "D" : "W") : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
string ctxTf   = tfAtLeastChart(ctxIn == "Auto" ? autoCtx : ctxIn)
[ctxTs, ctxDir] = request.security(syminfo.tickerid, ctxTf, htfTrend(sigSpan, enterThr, exitThr), lookahead = barmerge.lookahead_on)
string tf1 = tfAtLeastChart("60")
string tf2 = tfAtLeastChart("240")
string tf3 = tfAtLeastChart("D")
string tf4 = tfAtLeastChart("W")
[ts1, d1] = request.security(syminfo.tickerid, tf1, htfTrend(sigSpan, enterThr, exitThr), lookahead = barmerge.lookahead_on)
[ts2, d2] = request.security(syminfo.tickerid, tf2, htfTrend(sigSpan, enterThr, exitThr), lookahead = barmerge.lookahead_on)
[ts3, d3] = request.security(syminfo.tickerid, tf3, htfTrend(sigSpan, enterThr, exitThr), lookahead = barmerge.lookahead_on)
[ts4, d4] = request.security(syminfo.tickerid, tf4, htfTrend(sigSpan, enterThr, exitThr), lookahead = barmerge.lookahead_on)

// Helpers for setups B and R
float hhPrev   = ta.highest(high, brkLen)[1]
float llStop   = ta.lowest(low, 10)
bool  compPrev = atr[1] <= compRat * atrL[1]
float minExt   = ta.lowest(ext, revLb)

// ───── Structure: ATR-reversal swings, confirmed on the close ─────
var int   zdir         = 0
var float hiPx         = high
var int   hiBar        = 0
var float loPx         = low
var int   loBar        = 0
var float loSinceHi    = low
var int   loSinceHiBar = 0
var float hiSinceLo    = high
var int   hiSinceLoBar = 0
var float lastSH       = na
var float lastSL       = na
var float prevSH       = na
var float prevSL       = na
var int   lastSHbar    = -1
var int   lastSLbar    = -1
float shPrev = lastSH
float slPrev = lastSL

if zdir >= 0
    if high > hiPx
        hiPx         := high
        hiBar        := bar_index
        loSinceHi    := low
        loSinceHiBar := bar_index
    else if low < loSinceHi
        loSinceHi    := low
        loSinceHiBar := bar_index
if zdir <= 0
    if low < loPx
        loPx         := low
        loBar        := bar_index
        hiSinceLo    := high
        hiSinceLoBar := bar_index
    else if high > hiSinceLo
        hiSinceLo    := high
        hiSinceLoBar := bar_index

bool newSH = false
bool newSL = false
if not na(atr)
    if zdir >= 0 and close < hiPx - swingAtr * atr
        newSH     := true
        prevSH    := lastSH
        lastSH    := hiPx
        lastSHbar := hiBar
        zdir      := -1
        loPx      := loSinceHi
        loBar     := loSinceHiBar
        float m  = na
        int   mb = loBar
        for i = 0 to math.min(bar_index - loBar, 1999)
            if na(m) or high[i] > m
                m  := high[i]
                mb := bar_index - i
        hiSinceLo    := m
        hiSinceLoBar := mb
    else if zdir <= 0 and close > loPx + swingAtr * atr
        newSL     := true
        prevSL    := lastSL
        lastSL    := loPx
        lastSLbar := loBar
        zdir      := 1
        hiPx      := hiSinceLo
        hiBar     := hiSinceLoBar
        float m  = na
        int   mb = hiBar
        for i = 0 to math.min(bar_index - hiBar, 1999)
            if na(m) or low[i] < m
                m  := low[i]
                mb := bar_index - i
        loSinceHi    := m
        loSinceHiBar := mb

string swLbl = newSH ? (not na(prevSH) and lastSH > prevSH ? "HH" : not na(prevSH) ? "LH" : "SH") : newSL ? (not na(prevSL) and lastSL > prevSL ? "HL" : not na(prevSL) ? "LL" : "SL") : ""

// ───── Anchored VWAPs: recomputed from the pivot when a swing is confirmed, then extended bar by bar ─────
var float avlPV = 0.0
var float avlV  = 0.0
var float avhPV = 0.0
var float avhV  = 0.0
float vz = nz(volume)
if newSL
    avlPV := 0.0
    avlV  := 0.0
    for i = 0 to math.min(bar_index - lastSLbar, 1999)
        avlPV += hlc3[i] * nz(volume[i])
        avlV  += nz(volume[i])
else if lastSLbar >= 0
    avlPV += hlc3 * vz
    avlV  += vz
if newSH
    avhPV := 0.0
    avhV  := 0.0
    for i = 0 to math.min(bar_index - lastSHbar, 1999)
        avhPV += hlc3[i] * nz(volume[i])
        avhV  += nz(volume[i])
else if lastSHbar >= 0
    avhPV += hlc3 * vz
    avhV  += vz
float avwapL = avlV > 0 ? avlPV / avlV : na
float avwapH = avhV > 0 ? avhPV / avhV : na
float avwap  = dir >= 0 ? avwapL : avwapH

// ───── Structure breaks (levels as of the previous bar) ─────
bool breakUp = not na(shPrev) and close > shPrev and close[1] <= shPrev
bool breakDn = not na(slPrev) and close < slPrev and close[1] >= slPrev
var int lastDownBar = na
if dir == -1
    lastDownBar := bar_index

// ───── Setups: detected on every bar, whether or not a trade is open ─────
bool  rawD  = dipFirst and ctxDir == 1 and not na(atr)
float stopD = close - dipStop * atr
bool  rawB  = dir >= 0 and compPrev and not na(hhPrev) and close > hhPrev and (na(rvol) or rvol >= brkRvol)
float stopB = llStop - stopBuf * atr
bool  rawR  = breakUp and dir <= 0 and ts > -exitThr and not na(lastDownBar) and bar_index - lastDownBar <= revLb and minExt <= revExt and not na(lastSL)
float stopR = lastSL - stopBuf * atr
bool  fMkt  = not useMkt or mktDir >= 0

int   sigNow  = 0
float sigStop = na
if bar_index >= warmup
    if useD and rawD and fMkt
        sigNow  := 1
        sigStop := stopD
    else if useB and rawB and fMkt
        sigNow  := 2
        sigStop := stopB
    else if useR and rawR
        sigNow  := 3
        sigStop := stopR
    if sigNow > 0
        sigStop := math.round_to_mintick(math.min(sigStop, close - minStop * atr))
        if na(sigStop) or close - sigStop <= 0
            sigNow  := 0
            sigStop := na

// ───── Trade engine (one managed long position): exits first, then entries ─────
var bool  inTrade    = false
var float entryPx    = na
var float stopInit   = na
var float activeStop = na
var float hiSince    = na
var int   setupId    = 0
var int   entryBar   = na

bool  intrabar   = stopModeIn == STOP_INTRA
bool  exited     = false
int   exitReason = 0
float exitPx     = na
float exitR      = na
float stopLevel  = na
if inTrade
    if intrabar and low <= activeStop
        exitReason := activeStop > stopInit ? 2 : 1
        exitPx     := math.min(open, activeStop)
    else
        hiSince := math.max(hiSince, high)
        float cand     = hiSince - trailAtr * atr
        float level    = na(cand) ? activeStop : math.max(activeStop, math.round_to_mintick(cand))
        int   trendNow = setupId == 1 ? ctxDir : dir
        if not intrabar and close < level
            exitReason := level > stopInit ? 2 : 1
            exitPx     := close
        else if trendNow == -1
            exitReason := 3
            exitPx     := close
        else if maxBars > 0 and bar_index - entryBar >= maxBars
            exitReason := 4
            exitPx     := close
        else
            activeStop := level
            stopLevel  := level
    if exitReason > 0
        exitR   := (exitPx - entryPx) / (entryPx - stopInit)
        inTrade := false
        exited  := true

int newEntry = 0
if not inTrade and not exited and sigNow > 0
    inTrade    := true
    entryPx    := close
    stopInit   := sigStop
    activeStop := sigStop
    hiSince    := high
    setupId    := sigNow
    entryBar   := bar_index
    newEntry   := sigNow
    stopLevel  := sigStop

// Position size: risk budget ÷ stop distance, capped as a share of the account (R = half size)
float equityNow = equityIn // @equity
float shares    = newEntry > 0 ? math.floor(math.min(equityNow * riskPct / 100.0 / (entryPx - stopInit), equityNow * maxPosPct / 100.0 / close) * (newEntry == 3 ? 0.5 : 1.0)) : na
string setupName = newEntry == 1 ? "D dip in uptrend" : newEntry == 2 ? "B breakout" : newEntry == 3 ? "R reversal (half size)" : ""
string exitText  = exitReason == 1 ? "stop" : exitReason == 2 ? "trailing stop" : exitReason == 3 ? "trend turned down" : exitReason == 4 ? "time exit" : ""

// "If I buy this close": the same stop and size rules applied to the current bar, for your own entries
float planStop   = math.round_to_mintick(close - dipStop * atr)
float planShares = math.floor(math.min(equityNow * riskPct / 100.0 / (close - planStop), equityNow * maxPosPct / 100.0 / close))

// Next earnings date (live information only; na on symbols without earnings data)
float daysToEarn = na(earnings.future_time) ? na : (earnings.future_time - time_close) / 86400000.0
bool  earnSoon   = daysToEarn >= 0 and daysToEarn <= 7

// ───── Plots ─────
color ctxCol = stateColor(ctxDir)
bgcolor(showCtxBg and ctxDir == -1 ? color.new(C_DN, 92) : na, title = "Long-term trend down")
plot(base, "Baseline (colour = long-term trend)", color = ctxCol, linewidth = 2)
plot(showLevels ? lastSH : na, "Last swing high", color = color.new(C_DN, 45), style = plot.style_stepline)
plot(showLevels ? lastSL : na, "Last swing low", color = color.new(C_UP, 45), style = plot.style_stepline)
plot(showAvwap ? avwap : na, "Anchored VWAP", color = C_VWAP, linewidth = 1)
plot(stopLevel, "Stop / trailing stop", color = C_EXIT, linewidth = 2, style = plot.style_linebr)
barcolor(colorBars ? ctxCol : na)

plotshape(newEntry == 1 and conf, title = "D entry", style = shape.labelup, location = location.belowbar, color = C_ENTRY, text = "D", textcolor = color.white, size = size.small)
plotshape(newEntry == 2 and conf, title = "B entry", style = shape.labelup, location = location.belowbar, color = C_ENTRY, text = "B", textcolor = color.white, size = size.small)
plotshape(newEntry == 3 and conf, title = "R entry", style = shape.labelup, location = location.belowbar, color = C_ENTRY, text = "R", textcolor = color.white, size = size.small)
plotshape(sigNow > 0 and newEntry == 0 and conf, title = "Setup while a trade is open", style = shape.circle, location = location.belowbar, color = color.new(C_ENTRY, 30), size = size.tiny)
plotshape(exited and conf, title = "Exit", style = shape.labeldown, location = location.abovebar, color = C_EXIT, text = "X", textcolor = color.white, size = size.small)
plotshape(showBreaks and breakDn and dir >= 0 and conf, title = "Break down against the chart trend", style = shape.triangledown, location = location.abovebar, color = C_DN, size = size.tiny)
plotshape(showBreaks and breakUp and dir <= 0 and conf, title = "Break up against the chart trend", style = shape.triangleup, location = location.belowbar, color = C_UP, size = size.tiny)

// Diagnostic series for Pine ↔ Python parity checks (data window and chart export only)
plot(ts, "dbg_ts", display = display.data_window)
plot(dir, "dbg_dir", display = display.data_window)
plot(ctxDir, "dbg_ctx_dir", display = display.data_window)
plot(dipMove, "dbg_dip_z", display = display.data_window)
plot(ext, "dbg_ext", display = display.data_window)
plot(lastSH, "dbg_last_sh", display = display.data_window)
plot(lastSL, "dbg_last_sl", display = display.data_window)
plot(avwapL, "dbg_avwap_low", display = display.data_window)
plot(sigNow, "dbg_sig", display = display.data_window)
plot(sigStop, "dbg_sig_stop", display = display.data_window)
plot(newEntry, "dbg_entry", display = display.data_window)
plot(exitReason, "dbg_exit_reason", display = display.data_window)

// Swing labels (drawn at the swing bar once the swing is confirmed)
if showSwings and newSH and conf
    label.new(lastSHbar, lastSH, swLbl, style = label.style_label_down, color = color.new(C_DN, 85), textcolor = C_DN, size = size.tiny)
if showSwings and newSL and conf
    label.new(lastSLbar, lastSL, swLbl, style = label.style_label_up, color = color.new(C_UP, 85), textcolor = C_UP, size = size.tiny)

// Entry and exit labels with the numbers you need to place the order
if showTradeLabels and newEntry > 0 and conf
    label.new(bar_index, low, setupName + "\nEntry " + str.tostring(entryPx, format.mintick) + "\nStop " + str.tostring(stopInit, format.mintick) + "\n1R = " + str.tostring(entryPx - stopInit, format.mintick) + "\nSize " + str.tostring(shares, "#") + " sh" + (earnSoon ? "\nEarnings in " + str.tostring(daysToEarn, "#") + " d" : ""), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(C_ENTRY, 15), textcolor = color.white, size = size.small)
if showTradeLabels and exited and conf
    label.new(bar_index, high, "Exit: " + exitText + "\n" + str.tostring(exitPx, format.mintick) + "\n" + str.tostring(exitR, "0.00") + " R", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(C_EXIT, 15), textcolor = color.white, size = size.small)

// ───── Status table ─────
var table tbl = table.new(position.top_right, 2, 13, bgcolor = color.new(color.black, 85), border_width = 1)
if showTable and barstate.islast
    table.cell(tbl, 0, 0, "Long-term trend (" + ctxTf + ")", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, stateText(ctxDir, ctxTs, strongThr) + (ctxDir == -1 ? " — stand aside" : ""), text_color = stateColor(ctxDir), text_size = size.small)
    table.cell(tbl, 0, 1, "This chart", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, stateText(dir, ts, strongThr) + "  z " + str.tostring(ts, "0.0"), text_color = stateColor(dir), text_size = size.small)
    table.cell(tbl, 0, 2, "1h", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, isChartTf("60") ? stateText(dir, ts, strongThr) : tf1 == "60" ? stateText(d1, ts1, strongThr) : "—", text_color = isChartTf("60") ? stateColor(dir) : stateColor(d1), text_size = size.small)
    table.cell(tbl, 0, 3, "4h", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, isChartTf("240") ? stateText(dir, ts, strongThr) : tf2 == "240" ? stateText(d2, ts2, strongThr) : "—", text_color = isChartTf("240") ? stateColor(dir) : stateColor(d2), text_size = size.small)
    table.cell(tbl, 0, 4, "Daily", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, isChartTf("D") ? stateText(dir, ts, strongThr) : tf3 == "D" ? stateText(d3, ts3, strongThr) : "—", text_color = isChartTf("D") ? stateColor(dir) : stateColor(d3), text_size = size.small)
    table.cell(tbl, 0, 5, "Weekly", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, isChartTf("W") ? stateText(dir, ts, strongThr) : tf4 == "W" ? stateText(d4, ts4, strongThr) : "—", text_color = isChartTf("W") ? stateColor(dir) : stateColor(d4), text_size = size.small)
    table.cell(tbl, 0, 6, "Market (" + benchIn + ")", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 6, stateText(mktDir, mktTs, strongThr), text_color = stateColor(mktDir), text_size = size.small)
    table.cell(tbl, 0, 7, "Strength vs market", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 7, stateText(rsDir, rsTs, strongThr), text_color = stateColor(rsDir), text_size = size.small)
    table.cell(tbl, 0, 8, "5-bar move", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 8, str.tostring(dipMove, "0.0") + " σ" + (inDip ? (ctxDir == 1 ? " — dip in uptrend" : " — dip, no uptrend") : ""), text_color = inDip and ctxDir == 1 ? C_ENTRY : color.silver, text_size = size.small)
    table.cell(tbl, 0, 9, "Extension", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 9, str.tostring(ext, "0.0") + " ATR", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 0, 10, "Next earnings", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 10, na(daysToEarn) or daysToEarn < 0 ? "n/a" : "in " + str.tostring(daysToEarn, "#") + " days", text_color = earnSoon ? C_DN : color.silver, text_size = size.small)
    table.cell(tbl, 0, 11, "If I buy this close", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 11, "stop " + str.tostring(planStop, format.mintick) + " · " + str.tostring(planShares, "#") + " sh", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 0, 12, "Tracked trade", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 12, inTrade ? ((setupId == 1 ? "D" : setupId == 2 ? "B" : "R") + " · stop " + str.tostring(activeStop, format.mintick) + " · " + str.tostring((close - entryPx) / (entryPx - stopInit), "0.0") + " R") : "none", text_color = inTrade ? C_ENTRY : color.silver, text_size = size.small)

// ───── Alerts ─────
// "Any alert() function call" alerts carry the full details (entry, stop, size)
if newEntry > 0 and conf
    alert(syminfo.ticker + " " + timeframe.period + ": " + setupName + " — entry " + str.tostring(entryPx, format.mintick) + ", stop " + str.tostring(stopInit, format.mintick) + ", size " + str.tostring(shares, "#") + " sh" + (earnSoon ? ", earnings in " + str.tostring(daysToEarn, "#") + " d" : ""), alert.freq_once_per_bar_close)
if exited and conf
    alert(syminfo.ticker + " " + timeframe.period + ": exit (" + exitText + ") at " + str.tostring(exitPx, format.mintick) + ", " + str.tostring(exitR, "0.00") + " R", alert.freq_once_per_bar_close)
// @indicator-only begin
alertcondition(newEntry > 0 and conf, "T&S2 entry (tracked trade)", "T&S2 entry on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(exited and conf, "T&S2 exit (tracked trade)", "T&S2 exit on {{ticker}} ({{interval}})")
alertcondition(rawD and conf, "T&S2 dip in a long-term uptrend", "T&S2: dip in a long-term uptrend on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(ctxDir == -1 and ctxDir[1] != -1 and conf, "T&S2 long-term trend turned down", "T&S2: long-term trend turned DOWN on {{ticker}} ({{interval}})")
alertcondition(ctxDir == 1 and ctxDir[1] != 1 and conf, "T&S2 long-term trend turned up", "T&S2: long-term trend turned UP on {{ticker}} ({{interval}})")
// @indicator-only end
