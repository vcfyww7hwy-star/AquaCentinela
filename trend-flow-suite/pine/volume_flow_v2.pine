//@version=6
// Volume Flow v2 — trend-flow-suite, Phase 1 (lower pane)
// Python twin: research/tfs/flow.py — same maths and seeding; verify with research/tools/parity_check.py.
// Lines  Flow slow / fast (%): smoothed signed relative volume ÷ smoothed relative volume, bounded ±100%.
// Tint   Volume asymmetry z-score: volume heavier on up bars than is normal for this symbol (accumulation)
//        or on down bars (distribution). This is the only part of a VFI-type reading that is about volume.
// Marks  Climax, absorption, accumulation/distribution, divergences — on the bar where they become known.
// Spec and evidence: docs/03_volume_flow_v2.md. Personal research tool, not investment advice.
indicator("Volume Flow v2", shorttitle = "VF2", overlay = false, precision = 2, max_bars_back = 600, max_lines_count = 100)

// ───── Palette (Okabe-Ito, colour-blind safe) ─────
color C_UP   = #0072B2
color C_DN   = #D55E00
color C_FAST = #999999
color C_ACC  = #009E73
color C_DIS  = #CC79A7

// ───── Shared core: twins of research/tfs/core.py (seeded with first value; hold on na) ─────
ema1(float x, int n) =>
    float a = 2.0 / (n + 1)
    var float e = na
    e := na(e) ? x : na(x) ? e : a * x + (1.0 - a) * e
    e

rma1(float x, int n) =>
    float a = 1.0 / n
    var float e = na
    e := na(e) ? x : na(x) ? e : a * x + (1.0 - a) * e
    e

// Two-pole smoother: same mean lag as SMA(2n−1), far fewer whipsaws than a boxcar
smooth2(float x, int n) =>
    ema1(ema1(x, n), n)

// Standard normal CDF, Abramowitz & Stegun 7.1.26 (|error| < 1.5e-7)
phi(float x) =>
    float z = math.abs(x) / math.sqrt(2.0)
    float t = 1.0 / (1.0 + 0.3275911 * z)
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-z * z)
    x >= 0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)

// Per-slot EWMA returning the slot's value BEFORE this bar (no self-inclusion); updated on closed bars
slotEwmaLagged(float x, int slot, int span) =>
    var array<float> st = array.new<float>()
    while array.size(st) <= slot
        array.push(st, na)
    float prev = array.get(st, slot)
    if barstate.isconfirmed and not na(x)
        float a = 2.0 / (span + 1)
        array.set(st, slot, na(prev) ? x : a * x + (1.0 - a) * prev)
    prev

// Confirmed pivots, reported R bars after the pivot; strict inequalities on both sides
pivotHi(float src, int L, int R) =>
    float p = src[R]
    bool ok = not na(p)
    if ok and L > 0
        for i = 1 to L
            if not (p > src[R + i])
                ok := false
                break
    if ok and R > 0
        for i = 0 to R - 1
            if not (p > src[i])
                ok := false
                break
    ok ? p : na

pivotLo(float src, int L, int R) =>
    float p = src[R]
    bool ok = not na(p)
    if ok and L > 0
        for i = 1 to L
            if not (p < src[R + i])
                ok := false
                break
    if ok and R > 0
        for i = 0 to R - 1
            if not (p < src[i])
                ok := false
                break
    ok ? p : na

// ───── Inputs ─────
string G_FLOW = "Flow"
int    fastWin   = input.int(40, "Fast window (SMA-equivalent bars)", minval = 3, group = G_FLOW)
int    slowWin   = input.int(130, "Slow window (SMA-equivalent bars)", minval = 5, group = G_FLOW,
     tooltip = "130 gives the same average lag as the original 130-bar VFI.")
float  volCap    = input.float(3.0, "Cap on relative-volume weight", minval = 1.0, step = 0.5, group = G_FLOW)
int    normIntra = input.int(20, "Normalisation span, intraday (sessions, per time-of-day slot)", minval = 2, group = G_FLOW)
int    normDaily = input.int(50, "Normalisation span, daily and higher (bars)", minval = 2, group = G_FLOW)
bool   useLtf    = input.bool(false, "Classify volume with lower-timeframe bars", group = G_FLOW,
     tooltip = "Uses TradingView's Volume Delta rule on intrabars. History is limited by your plan's intrabar allowance; bars without intrabar data fall back to the bar-level estimate.")
string ltfTf     = input.timeframe("1", "Lower timeframe", group = G_FLOW)

string G_ASYM = "Volume asymmetry"
int    asymWin   = input.int(250, "Z-score window (bars)", minval = 20, group = G_ASYM)
float  asymThr   = input.float(2.0, "Accumulation / distribution threshold (σ)", minval = 0.5, step = 0.25, group = G_ASYM)
bool   showTint  = input.bool(true, "Tint background by asymmetry", group = G_ASYM)

string G_EV = "Events"
int    extWin    = input.int(50, "Extension baseline window (SMA-equivalent bars)", minval = 3, group = G_EV)
int    atrLen    = input.int(14, "ATR length", minval = 1, group = G_EV)
float  climRvol  = input.float(3.0, "Climax: relative volume ≥", group = G_EV)
float  climZ     = input.float(2.0, "Climax: |move| ≥ (σ)", group = G_EV)
float  climExt   = input.float(2.5, "Climax: |extension| ≥ (ATR)", group = G_EV)
float  absRvol   = input.float(2.0, "Absorption: relative volume ≥", group = G_EV)
float  absZ      = input.float(0.5, "Absorption: |move| ≤ (σ)", group = G_EV)
float  absExt    = input.float(1.5, "Absorption: |extension| ≥ (ATR)", group = G_EV)
float  dryRvol   = input.float(0.6, "Dry-up: relative volume ≤", group = G_EV)
bool   showDry   = input.bool(false, "Show dry-up bars", group = G_EV)

string G_DIV = "Divergences"
bool   showDiv   = input.bool(true, "Show divergences (price pivot vs fast flow)", group = G_DIV)
int    pivL      = input.int(5, "Pivot bars left", minval = 1, group = G_DIV)
int    pivR      = input.int(5, "Pivot bars right (confirmation delay)", minval = 1, group = G_DIV)
int    divGap    = input.int(60, "Max bars between pivots", minval = 5, group = G_DIV)

string G_EXP = "Experimental"
bool   showPers  = input.bool(false, "Show volume–return persistence in the table", group = G_EXP,
     tooltip = "Rolling regression r[t] = b0 + b1·r[t−1] + b2·r[t−1]·ln(RVOL[t−1]). b2 > 0: high-volume moves tend to continue; b2 < 0: they tend to reverse. Plain OLS t-stat; unstable in tests (E03). Not a signal.")
int    persWin   = input.int(500, "Persistence window (bars)", minval = 100, group = G_EXP)
bool   showTable = input.bool(true, "Show status table", group = "Display")

// ───── Data guard ─────
float cumVol = ta.cum(nz(volume))
if barstate.islast and cumVol == 0
    runtime.error("This symbol has no volume data. Use a symbol with volume (e.g. SPY instead of the SPX index).")

// ───── Normalisation: time-of-day slots intraday, one slot on D/W/M ─────
var int slotCount = -1
slotCount := session.isfirstbar ? 0 : slotCount + 1
int   slot  = timeframe.isintraday ? slotCount : 0
int   span  = timeframe.isintraday ? normIntra : normDaily
float r     = math.log(close / close[1])
float sigma = math.sqrt(slotEwmaLagged(r * r, slot, span))
float z     = sigma > 0 ? r / sigma : na
float sBvc  = 2.0 * phi(z) - 1.0

// Optional lower-timeframe classification (TradingView Volume Delta rule)
var float lastLtfC = na
var int   lastLtfD = 0
float sLtf = na
if useLtf
    [ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfTf, [open, close, volume], ignore_invalid_timeframe = true)
    float upV = 0.0
    float dnV = 0.0
    int nIntra = array.size(ltfC)
    if nIntra > 0
        for i = 0 to nIntra - 1
            float co = array.get(ltfC, i)
            float op = array.get(ltfO, i)
            float vo = array.get(ltfV, i)
            int d = co > op ? 1 : co < op ? -1 : (not na(lastLtfC) and co > lastLtfC) ? 1 : (not na(lastLtfC) and co < lastLtfC) ? -1 : lastLtfD
            if d > 0
                upV += vo
            else if d < 0
                dnV += vo
            lastLtfD := d
            lastLtfC := co
        sLtf := upV + dnV > 0 ? (upV - dnV) / (upV + dnV) : na
float s = na(sLtf) ? sBvc : sLtf

// Relative volume and its capped weight
float ev   = slotEwmaLagged(volume, slot, span)
float rvol = ev > 0 ? volume / ev : na
float w    = na(rvol) ? na : math.min(rvol, volCap)

// ───── Flow ratio and volume asymmetry ─────
float sv    = w * s
float wM    = na(sv) ? na : w
float sM    = na(sv) ? na : s
int   nF    = math.floor((fastWin + 1) / 2.0)
int   nS    = math.floor((slowWin + 1) / 2.0)
float numF  = smooth2(sv, nF)
float denF  = smooth2(wM, nF)
float numS  = smooth2(sv, nS)
float denS  = smooth2(wM, nS)
float fFast = denF > 0 ? numF / denF : na
float fSlow = denS > 0 ? numS / denS : na
float fUnw  = smooth2(sM, nS)
float asym  = fSlow - fUnw
float asymM = ta.sma(asym, asymWin)
float asymS = ta.stdev(asym, asymWin)
float asymZ = asymS > 0 ? (asym - asymM) / asymS : na

// ───── Price context: extension from a two-pole baseline, in ATR units ─────
float tr   = na(close[1]) ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
float atr  = rma1(tr, atrLen)
int   nE   = math.floor((extWin + 1) / 2.0)
float base = smooth2(close, nE)
float ext  = atr > 0 ? (close - base) / atr : na

// ───── Events ─────
bool conf   = barstate.isconfirmed
bool climUp = rvol >= climRvol and z >= climZ and ext >= climExt
bool climDn = rvol >= climRvol and z <= -climZ and ext <= -climExt
bool absorb = rvol >= absRvol and math.abs(z) <= absZ and math.abs(ext) >= absExt
bool absTop = absorb and ext > 0
bool absBot = absorb and ext < 0
bool dryUp  = rvol <= dryRvol
bool accum  = asymZ > asymThr and asymZ[1] <= asymThr
bool distr  = asymZ < -asymThr and asymZ[1] >= -asymThr

// ───── Divergences: confirmed price pivots vs fast flow at the pivot bar ─────
float ph = pivotHi(high, pivL, pivR)
float pl = pivotLo(low, pivL, pivR)
var float lastPH    = na
var int   lastPHbar = na
var float lastPHf   = na
var float lastPL    = na
var int   lastPLbar = na
var float lastPLf   = na
bool bearDiv = false
bool bullDiv = false
if not na(ph)
    int   pb = bar_index - pivR
    float fv = fFast[pivR]
    if not na(lastPH) and pb - lastPHbar <= divGap and ph > lastPH and not na(fv) and not na(lastPHf) and fv < lastPHf
        bearDiv := true
        if showDiv and conf
            line.new(lastPHbar, lastPHf * 100, pb, fv * 100, color = C_DN, width = 1)
    lastPH    := ph
    lastPHbar := pb
    lastPHf   := fv
if not na(pl)
    int   pb = bar_index - pivR
    float fv = fFast[pivR]
    if not na(lastPL) and pb - lastPLbar <= divGap and pl < lastPL and not na(fv) and not na(lastPLf) and fv > lastPLf
        bullDiv := true
        if showDiv and conf
            line.new(lastPLbar, lastPLf * 100, pb, fv * 100, color = C_UP, width = 1)
    lastPL    := pl
    lastPLbar := pb
    lastPLf   := fv

// ───── Experimental: volume–return persistence (Llorente et al. 2002 style), rolling OLS ─────
float lv    = rvol > 0 ? math.log(rvol) : na
float x1    = r[1]
float x2    = r[1] * lv[1]
bool  okP   = not na(r) and not na(x1) and not na(x2)
float mA    = math.sum(okP ? 1.0 : 0.0, persWin)
float mB    = math.sum(okP ? x1 : 0.0, persWin)
float mC    = math.sum(okP ? x2 : 0.0, persWin)
float vG    = math.sum(okP ? r : 0.0, persWin)
float mD    = math.sum(okP ? x1 * x1 : 0.0, persWin)
float mF    = math.sum(okP ? x2 * x2 : 0.0, persWin)
float mE    = math.sum(okP ? x1 * x2 : 0.0, persWin)
float vH    = math.sum(okP ? x1 * r : 0.0, persWin)
float vK    = math.sum(okP ? x2 * r : 0.0, persWin)
float vYY   = math.sum(okP ? r * r : 0.0, persWin)
float det   = mA * (mD * mF - mE * mE) - mB * (mB * mF - mC * mE) + mC * (mB * mE - mC * mD)
float b0    = (vG * (mD * mF - mE * mE) - mB * (vH * mF - mE * vK) + mC * (vH * mE - mD * vK)) / det
float b1    = (mA * (vH * mF - mE * vK) - vG * (mB * mF - mE * mC) + mC * (mB * vK - vH * mC)) / det
float b2    = (mA * (mD * vK - vH * mE) - mB * (mB * vK - vH * mC) + vG * (mB * mE - mD * mC)) / det
float ssr   = vYY - (b0 * vG + b1 * vH + b2 * vK)
float varB2 = ssr / (mA - 3.0) * (mA * mD - mB * mB) / det
bool  persOk = mA >= 100 and det > 0 and varB2 > 0
float persC = persOk ? b2 : na
float persT = persOk ? b2 / math.sqrt(varB2) : na

// ───── Plots ─────
color tint = not showTint or na(asymZ) ? na : asymZ >= asymThr ? color.new(C_ACC, 72) : asymZ >= 1.0 ? color.new(C_ACC, 88) : asymZ <= -asymThr ? color.new(C_DIS, 72) : asymZ <= -1.0 ? color.new(C_DIS, 88) : na
bgcolor(tint, title = "Asymmetry tint")
hline(0, "Zero", color = color.new(color.gray, 40))
plot(fFast * 100, "Flow fast %", color = C_FAST, linewidth = 1)
plot(fSlow * 100, "Flow slow %", color = fSlow >= 0 ? C_UP : C_DN, linewidth = 2)

plotshape(climUp and conf, title = "Buying climax", style = shape.xcross, location = location.top, color = C_DN, size = size.small)
plotshape(climDn and conf, title = "Selling climax", style = shape.xcross, location = location.bottom, color = C_UP, size = size.small)
plotshape(absTop and conf, title = "Absorption at top", style = shape.square, location = location.top, color = C_DN, size = size.tiny)
plotshape(absBot and conf, title = "Absorption at bottom", style = shape.square, location = location.bottom, color = C_UP, size = size.tiny)
plotshape(accum and conf, title = "Accumulation", style = shape.triangleup, location = location.bottom, color = C_ACC, size = size.tiny)
plotshape(distr and conf, title = "Distribution", style = shape.triangledown, location = location.top, color = C_DIS, size = size.tiny)
plotshape(showDiv and bearDiv and conf, title = "Bearish divergence", style = shape.labeldown, location = location.top, color = C_DN, text = "D", textcolor = color.white, size = size.tiny)
plotshape(showDiv and bullDiv and conf, title = "Bullish divergence", style = shape.labelup, location = location.bottom, color = C_UP, text = "D", textcolor = color.white, size = size.tiny)
plotshape(showDry and dryUp and conf, title = "Dry-up", style = shape.circle, location = location.bottom, color = color.new(color.gray, 40), size = size.tiny)

// Diagnostic series for Pine ↔ Python parity checks (data window and chart export only)
plot(z, "dbg_z", display = display.data_window)
plot(s, "dbg_s", display = display.data_window)
plot(rvol, "dbg_rvol", display = display.data_window)
plot(fFast, "dbg_f_fast", display = display.data_window)
plot(fSlow, "dbg_f_slow", display = display.data_window)
plot(asym, "dbg_asym", display = display.data_window)
plot(asymZ, "dbg_asym_z", display = display.data_window)
plot(ext, "dbg_ext", display = display.data_window)
plot(persC, "dbg_persist_c", display = display.data_window)

// ───── Status table ─────
var string lastEvt = "—"
if conf
    string d = str.format_time(time, "yyyy-MM-dd", syminfo.timezone)
    if climUp
        lastEvt := "Buying climax " + d
    if climDn
        lastEvt := "Selling climax " + d
    if absTop
        lastEvt := "Absorption (top) " + d
    if absBot
        lastEvt := "Absorption (bottom) " + d
    if accum
        lastEvt := "Accumulation " + d
    if distr
        lastEvt := "Distribution " + d
    if bearDiv
        lastEvt := "Bearish divergence " + d
    if bullDiv
        lastEvt := "Bullish divergence " + d

var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 85), border_width = 1)
if showTable and barstate.islast
    table.cell(tbl, 0, 0, "Flow slow", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 0, str.tostring(fSlow * 100, "0.0") + "%", text_color = fSlow >= 0 ? C_UP : C_DN, text_size = size.small)
    table.cell(tbl, 0, 1, "Flow fast", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, str.tostring(fFast * 100, "0.0") + "%", text_color = fFast >= 0 ? C_UP : C_DN, text_size = size.small)
    table.cell(tbl, 0, 2, "Asymmetry", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(asymZ, "0.00") + " σ", text_color = asymZ >= 0 ? C_ACC : C_DIS, text_size = size.small)
    table.cell(tbl, 0, 3, "Rel. volume", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, str.tostring(rvol, "0.00") + "×", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 0, 4, "Last event", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, lastEvt, text_color = color.silver, text_size = size.small)
    if showPers
        table.cell(tbl, 0, 5, "Persistence", text_color = color.gray, text_size = size.small)
        table.cell(tbl, 1, 5, na(persC) ? "n/a" : (persC > 0 ? "continue " : "reverse ") + "(t=" + str.tostring(persT, "0.0") + ")", text_color = color.silver, text_size = size.small)

// ───── Alerts (fire once, at bar close) ─────
alertcondition(accum and conf, "VF2 accumulation", "VF2: accumulation on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(distr and conf, "VF2 distribution", "VF2: distribution on {{ticker}} ({{interval}}) at {{close}}")
alertcondition((climUp or climDn) and conf, "VF2 climax", "VF2: volume climax on {{ticker}} ({{interval}}) at {{close}}")
alertcondition((absTop or absBot) and conf, "VF2 absorption", "VF2: absorption on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(bearDiv and conf, "VF2 bearish divergence", "VF2: bearish divergence on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(bullDiv and conf, "VF2 bullish divergence", "VF2: bullish divergence on {{ticker}} ({{interval}}) at {{close}}")
