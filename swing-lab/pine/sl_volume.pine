//@version=6
// SL Volume (swing-lab), version 1.0
//
// How unusual is this bar's volume for this stock, and, during the session on a daily chart, how fast is today's
// volume running compared with a typical day at the same time? Descriptive only: in the research behind it no
// volume pattern predicted direction (swing-lab/docs/RESEARCH_LOG.md, entries 4 and 10), and relative volume
// added almost nothing to ATR for the size of the next moves (G80). It replaces, for this project, the
// "Relative Volume" pane of trend-flow-suite, which is left unchanged.
//
//   Columns    volume / typical volume. Typical = the MEDIAN of the previous bars (daily and higher) or of the
//              previous sessions' bars at the same clock time (intraday). 1.0 = a typical bar. A median, not a
//              mean: one huge day does not raise "typical" for weeks, and 1.0 is a typical bar, not an average one.
//   Pace       daily chart, while the session is open: volume so far today / typical volume by this time of day,
//              from 5-minute bars of the last 20 sessions.
//   Market     the same ratio for the index (default SPY) and the stock's ratio divided by it: is the volume about
//              this stock or about the whole market (Fed day, option expiry, index rebalancing)?
//   E          an earnings report on this bar (after-close reports trade the next day).
//
// Volume comes from the chart's data feed. Without NASDAQ/NYSE real-time data TradingView shows Cboe data, a part
// of all US trading: see the data check in swing-lab/docs/PLAYBOOK.md before trusting live readings.
indicator("SL Volume", shorttitle = "SL Volume", overlay = false, precision = 2)

// ─────────────────────────────────────────────────────────────── inputs
string G1 = "Typical volume"
int    i_nDaily = input.int(50, "Daily and higher: bars in the median", minval = 10, maxval = 500, group = G1, display = display.none)
int    i_nIntra = input.int(20, "Intraday: sessions in the median, per time of day", minval = 5, maxval = 60, group = G1, display = display.none)
int    i_rankN  = input.int(250, "Daily and higher: bars for the rank", minval = 20, maxval = 1000, group = G1, display = display.none,
     tooltip = "The table says where this bar's volume ranks among this many earlier bars (250 daily bars is about a year).")
float  i_level  = input.float(2.0, "Unusual at ×", minval = 1.2, step = 0.1, group = G1,
     tooltip = "Columns at or above this multiple of a typical bar are drawn solid. In liquid US stocks about 1 day in 20 reaches 2× the median (G80).")

string G2 = "Pace (daily chart, session open)"
bool   i_pace    = input.bool(true, "Show today's pace", group = G2)
int    i_paceN   = input.int(20, "Sessions in the typical intraday curve", minval = 10, maxval = 40, group = G2, display = display.none)

string G3 = "Market"
bool   i_mktOn = input.bool(true, "Compare with the index", group = G3)
string i_mkt   = input.symbol("AMEX:SPY", "Index", group = G3, display = display.none)

string G4 = "Alerts (one alert: Any alert() function call)"
bool   i_alUnusual = input.bool(true, "At the close of an unusual bar", group = G4)
bool   i_alPace    = input.bool(false, "During the session, when today's pace reaches", group = G4, inline = "p")
float  i_paceLevel = input.float(2.5, "", minval = 1.2, step = 0.1, group = G4, inline = "p",
     tooltip = "Daily chart only. Sent at most once a day, and only after the first hour: before 10:30 a pace of 2 ends at 2 or more only 4 times in 10 (G81). It reads a bar that is still forming: it is meant to make you look, not to trade on.")

string G5 = "Look"
bool   i_showE    = input.bool(true, "Mark earnings reports (E)", group = G5)
string i_tablePos = input.string("Top right", "Table", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Off"], group = G5, display = display.none)
string i_textSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G5, display = display.none)
color  i_cUpIn    = input.color(#4C8BF5, "Up bar", group = G5)
color  i_cDnIn    = input.color(#F0A030, "Down bar", group = G5)

// colours: as chosen on a dark chart, darkened on a light one
bool LIGHT_BG = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color) > 140
f_ink(color c) =>
    LIGHT_BG ? color.rgb(0.62 * color.r(c), 0.62 * color.g(c), 0.62 * color.b(c)) : c
color C_UP    = f_ink(i_cUpIn)
color C_DN    = f_ink(i_cDnIn)
color C_FG    = chart.fg_color
color C_MUTED = color.new(chart.fg_color, 45)

int  tfSec   = timeframe.in_seconds()
bool isIntra = tfSec < 86400
bool isDaily = tfSec == 86400
bool hasVol  = ta.cum(nz(volume)) > 0

// ─────────────────────────────────────────────────────────────── typical volume, daily and higher: median of the previous bars
float typD  = ta.median(volume, i_nDaily)[1]
float rankD = ta.percentrank(volume, i_rankN)          // % of the previous i_rankN bars at or below this one

// ─────────────────────────────────────────────────────────────── typical volume, intraday: median per clock time
// The key is the bar's clock time on the exchange, so a missing bar (a halt, an illiquid stock, the pre-market)
// cannot shift every later bar of the day into the wrong slot. A bar is added to its slot only once it is closed.
type Slot
    array<float> vals

var map<int, Slot> slots = map.new<int, Slot>()
int   key   = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
float typI  = na
float rankI = na
int   nI    = 0
if isIntra
    Slot s = slots.contains(key) ? slots.get(key) : na
    if not na(s)
        nI := s.vals.size()
        if nI >= math.max(5, i_nIntra / 2)
            typI := s.vals.median()
            int below = 0
            for x in s.vals
                below += x <= volume ? 1 : 0
            rankI := 100.0 * below / nI
    if barstate.isconfirmed and volume > 0
        if na(s)
            s := Slot.new(array.new<float>())
            slots.put(key, s)
        s.vals.push(volume)
        if s.vals.size() > i_nIntra
            s.vals.shift()

float typ   = isIntra ? typI : typD
float ratio = typ > 0 ? volume / typ : na
float rank  = isIntra ? rankI : rankD
bool  live  = not barstate.isconfirmed                   // the bar is still forming: its volume is partial

// ─────────────────────────────────────────────────────────────── pace: today so far against a typical day so far
// One row per past session: cumulative regular-session volume at the end of each 5-minute slot from 09:30.
// Today: volume so far, against the median of the past sessions' volume at the same point of the day, with the
// current 5-minute slot counted pro rata by the clock.
int GRID = 78
type DayCurve
    array<float> cum

string symReg = ticker.modify(syminfo.tickerid, session.regular)
[ltT, ltV] = request.security_lower_tf(symReg, "5", [time, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true, calc_bars_count = 4000)

f_slotOf(int t) =>
    math.max(0, math.min(GRID - 1, int(math.floor((hour(t, syminfo.timezone) * 60 + minute(t, syminfo.timezone) - 570) / 5.0))))

var array<DayCurve> curves = array.new<DayCurve>()
bool paceUsable = isDaily and i_pace and syminfo.timezone == "America/New_York"
if paceUsable and barstate.isconfirmed and array.size(ltV) > 0 and last_bar_index - bar_index <= 3 * i_paceN
    array<float> cum = array.new<float>(GRID, na)
    float run = 0.0
    for j = 0 to array.size(ltV) - 1
        run += nz(array.get(ltV, j))
        array.set(cum, f_slotOf(array.get(ltT, j)), run)
    float last = 0.0
    for g = 0 to GRID - 1                                // slots without a 5-minute bar carry the previous total
        float x = array.get(cum, g)
        if na(x)
            array.set(cum, g, last)
        else
            last := x
    curves.push(DayCurve.new(cum))
    if curves.size() > i_paceN
        curves.shift()

float pace     = na
float dayShare = na
int   paceSlot = na
if paceUsable and live and array.size(ltV) > 0 and curves.size() >= 10
    float soFar = array.sum(ltV)
    paceSlot := f_slotOf(array.last(ltT))
    float frac = math.max(0.0, math.min(1.0, (timenow - array.last(ltT)) / 300000.0))
    array<float> typNow = array.new<float>()
    array<float> shareNow = array.new<float>()
    for d in curves
        float prev = paceSlot > 0 ? d.cum.get(paceSlot - 1) : 0.0
        float atT  = prev + frac * (d.cum.get(paceSlot) - prev)
        float tot  = d.cum.get(GRID - 1)
        typNow.push(atT)
        if tot > 0
            shareNow.push(atT / tot)
    float tn = typNow.median()
    pace     := tn > 0 ? soFar / tn : na
    dayShare := shareNow.size() > 0 ? shareNow.median() : na

// ─────────────────────────────────────────────────────────────── market: the index's ratio, same method (daily and higher)
f_ratioD() =>
    float t = ta.median(volume, i_nDaily)[1]
    t > 0 ? volume / t : na
float mktRatio = i_mktOn and not isIntra ? request.security(i_mkt, timeframe.period, f_ratioD(), ignore_invalid_symbol = true) : na
float ownRatio = not na(ratio) and mktRatio > 0 ? ratio / mktRatio : na

// ─────────────────────────────────────────────────────────────── earnings
float eAct = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, ignore_invalid_symbol = true)
bool  eBar = not isIntra and not na(eAct)

// ─────────────────────────────────────────────────────────────── plots
color colCol = live ? color.new(C_MUTED, 40) : close >= close[1] ? color.new(C_UP, ratio >= i_level ? 0 : 50) : color.new(C_DN, ratio >= i_level ? 0 : 50)
plot(hasVol ? ratio : na, "Volume vs typical", color = colCol, style = plot.style_columns)
hline(1.0, "Typical bar (median)", color = color.new(color.gray, 30), linestyle = hline.style_solid)
hline(i_level, "Unusual", color = color.new(color.gray, 60), linestyle = hline.style_dotted)
plot(barstate.islast ? pace : na, "Pace today", color = C_FG, style = plot.style_circles, linewidth = 4, display = display.pane)
plotshape(i_showE and eBar, "Earnings report", style = shape.labelup, location = location.bottom, color = color.new(C_MUTED, 30),
     text = "E", textcolor = chart.bg_color, size = size.tiny)

plot(ratio,    "Ratio to typical",  display = display.data_window)
plot(typ,      "Typical volume",    display = display.data_window)
plot(rank,     "Rank pct",          display = display.data_window)
plot(pace,     "Pace",              display = display.data_window)
plot(mktRatio, "Index ratio",       display = display.data_window)
plot(ownRatio, "Ratio vs index",    display = display.data_window)

// ─────────────────────────────────────────────────────────────── alerts
bool unusual = hasVol and barstate.isconfirmed and ratio >= i_level
if i_alUnusual and unusual
    alert(str.format("{0} ({1}): volume {2}× a typical bar{3}{4}{5}. Descriptive only: volume did not predict direction in the tests.",
         syminfo.ticker, timeframe.period, str.tostring(ratio, "0.0"),
         na(rank) ? "" : ", higher than " + str.tostring(rank, "0") + "% of " + (isIntra ? "the same hour's earlier bars" : "the last " + str.tostring(i_rankN) + " bars"),
         na(ownRatio) ? "" : "; index " + str.tostring(mktRatio, "0.0") + "×, so " + str.tostring(ownRatio, "0.0") + "× the market's",
         eBar ? "; earnings report on this bar" : ""), alert.freq_once_per_bar_close)
if i_alPace and paceUsable and live and pace >= i_paceLevel and paceSlot >= 12
    alert(str.format("{0}: volume running at {1}× a typical day by {2} (about {3}% of a typical day done). Bar still forming.",
         syminfo.ticker, str.tostring(pace, "0.0"), str.format_time(timenow, "HH:mm", syminfo.timezone), str.tostring(100.0 * dayShare, "0")),
         alert.freq_once_per_bar)

// ─────────────────────────────────────────────────────────────── table
f_pos(string p) =>
    p == "Top left" ? position.top_left : p == "Bottom right" ? position.bottom_right : p == "Bottom left" ? position.bottom_left : position.top_right

string TS = i_textSize == "Tiny" ? size.tiny : i_textSize == "Small" ? size.small : size.normal
var table tb = na

f_row(int r, string k, string v, color vc, string tip) =>
    table.cell(tb, 0, r, k, text_halign = text.align_left, text_size = TS, text_color = C_MUTED, tooltip = tip)
    table.cell(tb, 1, r, v, text_halign = text.align_left, text_size = TS, text_color = vc, tooltip = tip)

f_x(float x) =>
    na(x) ? "-" : str.tostring(x, "0.0") + "×"

if barstate.islast and i_tablePos != "Off"
    if not na(tb)
        table.delete(tb)
    tb := table.new(f_pos(i_tablePos), 2, 8, bgcolor = color.new(chart.bg_color, 6), frame_color = color.new(chart.fg_color, 78), frame_width = 1, border_width = 0)
    color acc = f_ink(#4C8BF5)
    table.cell(tb, 0, 0, "SL VOLUME", text_halign = text.align_left, text_size = TS, text_color = color.white, bgcolor = acc, text_formatting = text.format_bold)
    table.cell(tb, 1, 0, syminfo.ticker + " · " + timeframe.period, text_halign = text.align_left, text_size = TS, text_color = color.white, bgcolor = acc)
    int r = 1
    if not hasVol
        f_row(r, "Data", "no volume for this symbol", f_ink(#F0A030), "Use a symbol with volume: SPY rather than the SPX index.")
        r += 1
    else
        string what = isIntra ? "This bar" : "Today"
        if live
            f_row(r, what, "forming: " + f_x(ratio) + " so far", C_MUTED,
                 "The bar is not finished, so its volume is partial. On a daily chart read the pace below; the column is final at the close.")
        else
            f_row(r, what, f_x(ratio) + " typical" + (na(rank) ? "" : " · above " + str.tostring(rank, "0") + "%"), ratio >= i_level ? C_FG : C_MUTED,
                 isIntra ? "Volume against the median of the last " + str.tostring(i_nIntra) + " sessions' bars at this clock time; then the share of those bars it exceeds or equals." :
                 "Volume against the median of the previous " + str.tostring(i_nDaily) + " bars; then the share of the previous " + str.tostring(i_rankN) + " bars it exceeds or equals.")
        r += 1
        if paceUsable and live
            f_row(r, "Pace", na(pace) ? "needs 10 sessions of 5-minute data" : f_x(pace) + " by " + str.format_time(timenow, "HH:mm", syminfo.timezone) + " · " +
                 str.tostring(100.0 * dayShare, "0") + "% of a day done", na(pace) ? C_MUTED : pace >= i_level ? C_FG : C_MUTED,
                 "Regular-session volume so far today against the median of the last " + str.tostring(i_paceN) + " sessions at the same time of day. Early in the session the number moves a lot.")
            r += 1
        if i_mktOn and not isIntra and not live
            f_row(r, "vs market", na(ownRatio) ? "-" : f_x(ownRatio) + " · " + syminfo.ticker(i_mkt) + " " + f_x(mktRatio), C_MUTED,
                 "This stock's ratio divided by the index's. Near 1: the whole market traded heavily (Fed day, option expiry, rebalancing). Well above 1: the volume is about this stock. Descriptive, not tested.")
            r += 1
        if eBar or (not isIntra and not na(eAct[1]))
            f_row(r, "Earnings", eBar ? "report on this bar" : "report on the previous bar", C_MUTED, "Report days and the day after carry the heaviest volume of the quarter; that is expected, not news.")
            r += 1
    table.cell(tb, 0, r, "Descriptive", text_halign = text.align_left, text_size = size.tiny, text_color = C_MUTED,
         tooltip = "Volume did not predict direction in the tests behind this script (swing-lab RESEARCH_LOG entries 4 and 10).")
    table.cell(tb, 1, r, "no direction · check the data feed", text_halign = text.align_left, text_size = size.tiny, text_color = C_MUTED,
         tooltip = "Without NASDAQ/NYSE real-time data, live volume is Cboe's share only. See the data check in the playbook.")
