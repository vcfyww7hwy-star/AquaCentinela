//@version=6
// SL Portfolio Desk (swing-lab), version 1.1
//
// One table and one alert for the whole book: up to ten open positions, each with its result in R, its day
// count, the money still at risk to its stop and its next earnings date; and for the book as a whole the
// exposure, the open risk if every stop were filled, how far the book usually moves over the holding period
// given how the positions move together, and how many independent positions it really behaves like.
// It gives no buy or sell signal. Use it on the DAILY chart of a US stock or ETF (for example SPY): the chart
// supplies the trading days, the positions come from the inputs.
//
// Evidence tags:
//   D  demonstrated out of sample on data set aside for 2023-2026 (swing-lab/docs/RESEARCH_LOG.md, entry 7)
//   C  checked once on 2023-2026 with constants committed beforehand, outside the pre-registered list (entry 8)
//
// Values are daily and final at the close. One alert ("Any alert() function call") covers every position.
indicator("SL Portfolio Desk", shorttitle = "SL Portfolio", overlay = true)

// ─────────────────────────────────────────────────────────────── inputs
string GB = "Book"
float  i_equity  = input.float(100000.0, "Account equity", minval = 1.0, step = 1000.0, group = GB, tooltip = "In the currency of the positions.", display = display.none)
int    i_hold    = input.int(10, "Holding period, daily bars", options = [5, 10, 20], group = GB)
float  i_heatMax = input.float(6.0, "Alert when the open risk to the stops exceeds, % of equity", minval = 0.5, step = 0.5, group = GB, display = display.none,
     tooltip = "Open risk = what the book loses from here if every stop fills at its price. Stops can fill lower: about 15% do.")

string TIP_SYM = "A row is on when its shares are above 0."
string TIP_ROW = "Four numbers: shares, the price you paid, the FIRST stop you placed (entry minus this stop is 1 R for the whole trade), and the stop as it stands now if you moved it (leave 0 if you did not)."
int    T0      = timestamp("2026-01-02T12:00:00")       // noon UTC: the same calendar day in every chart time zone; only the date matters

string G1 = "Position 1"
string s1 = input.symbol("", "Symbol", group = G1, tooltip = TIP_SYM, display = display.none)
float  q1 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G1, inline = "a1", tooltip = TIP_ROW, display = display.none)
float  p1 = input.float(0.0, "", minval = 0.0, group = G1, inline = "a1", display = display.none)
float  x1 = input.float(0.0, "", minval = 0.0, group = G1, inline = "a1", display = display.none)
float  y1 = input.float(0.0, "", minval = 0.0, group = G1, inline = "a1", display = display.none)
int    t1 = input.time(T0, "Entry date", group = G1, display = display.none)
string G2 = "Position 2"
string s2 = input.symbol("", "Symbol", group = G2, tooltip = TIP_SYM, display = display.none)
float  q2 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G2, inline = "a2", tooltip = TIP_ROW, display = display.none)
float  p2 = input.float(0.0, "", minval = 0.0, group = G2, inline = "a2", display = display.none)
float  x2 = input.float(0.0, "", minval = 0.0, group = G2, inline = "a2", display = display.none)
float  y2 = input.float(0.0, "", minval = 0.0, group = G2, inline = "a2", display = display.none)
int    t2 = input.time(T0, "Entry date", group = G2, display = display.none)
string G3 = "Position 3"
string s3 = input.symbol("", "Symbol", group = G3, tooltip = TIP_SYM, display = display.none)
float  q3 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G3, inline = "a3", tooltip = TIP_ROW, display = display.none)
float  p3 = input.float(0.0, "", minval = 0.0, group = G3, inline = "a3", display = display.none)
float  x3 = input.float(0.0, "", minval = 0.0, group = G3, inline = "a3", display = display.none)
float  y3 = input.float(0.0, "", minval = 0.0, group = G3, inline = "a3", display = display.none)
int    t3 = input.time(T0, "Entry date", group = G3, display = display.none)
string G4 = "Position 4"
string s4 = input.symbol("", "Symbol", group = G4, tooltip = TIP_SYM, display = display.none)
float  q4 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G4, inline = "a4", tooltip = TIP_ROW, display = display.none)
float  p4 = input.float(0.0, "", minval = 0.0, group = G4, inline = "a4", display = display.none)
float  x4 = input.float(0.0, "", minval = 0.0, group = G4, inline = "a4", display = display.none)
float  y4 = input.float(0.0, "", minval = 0.0, group = G4, inline = "a4", display = display.none)
int    t4 = input.time(T0, "Entry date", group = G4, display = display.none)
string G5 = "Position 5"
string s5 = input.symbol("", "Symbol", group = G5, tooltip = TIP_SYM, display = display.none)
float  q5 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G5, inline = "a5", tooltip = TIP_ROW, display = display.none)
float  p5 = input.float(0.0, "", minval = 0.0, group = G5, inline = "a5", display = display.none)
float  x5 = input.float(0.0, "", minval = 0.0, group = G5, inline = "a5", display = display.none)
float  y5 = input.float(0.0, "", minval = 0.0, group = G5, inline = "a5", display = display.none)
int    t5 = input.time(T0, "Entry date", group = G5, display = display.none)
string G6 = "Position 6"
string s6 = input.symbol("", "Symbol", group = G6, tooltip = TIP_SYM, display = display.none)
float  q6 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G6, inline = "a6", tooltip = TIP_ROW, display = display.none)
float  p6 = input.float(0.0, "", minval = 0.0, group = G6, inline = "a6", display = display.none)
float  x6 = input.float(0.0, "", minval = 0.0, group = G6, inline = "a6", display = display.none)
float  y6 = input.float(0.0, "", minval = 0.0, group = G6, inline = "a6", display = display.none)
int    t6 = input.time(T0, "Entry date", group = G6, display = display.none)
string G7 = "Position 7"
string s7 = input.symbol("", "Symbol", group = G7, tooltip = TIP_SYM, display = display.none)
float  q7 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G7, inline = "a7", tooltip = TIP_ROW, display = display.none)
float  p7 = input.float(0.0, "", minval = 0.0, group = G7, inline = "a7", display = display.none)
float  x7 = input.float(0.0, "", minval = 0.0, group = G7, inline = "a7", display = display.none)
float  y7 = input.float(0.0, "", minval = 0.0, group = G7, inline = "a7", display = display.none)
int    t7 = input.time(T0, "Entry date", group = G7, display = display.none)
string G8 = "Position 8"
string s8 = input.symbol("", "Symbol", group = G8, tooltip = TIP_SYM, display = display.none)
float  q8 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G8, inline = "a8", tooltip = TIP_ROW, display = display.none)
float  p8 = input.float(0.0, "", minval = 0.0, group = G8, inline = "a8", display = display.none)
float  x8 = input.float(0.0, "", minval = 0.0, group = G8, inline = "a8", display = display.none)
float  y8 = input.float(0.0, "", minval = 0.0, group = G8, inline = "a8", display = display.none)
int    t8 = input.time(T0, "Entry date", group = G8, display = display.none)
string G9 = "Position 9"
string s9 = input.symbol("", "Symbol", group = G9, tooltip = TIP_SYM, display = display.none)
float  q9 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G9, inline = "a9", tooltip = TIP_ROW, display = display.none)
float  p9 = input.float(0.0, "", minval = 0.0, group = G9, inline = "a9", display = display.none)
float  x9 = input.float(0.0, "", minval = 0.0, group = G9, inline = "a9", display = display.none)
float  y9 = input.float(0.0, "", minval = 0.0, group = G9, inline = "a9", display = display.none)
int    t9 = input.time(T0, "Entry date", group = G9, display = display.none)
string G10 = "Position 10"
string s10 = input.symbol("", "Symbol", group = G10, tooltip = TIP_SYM, display = display.none)
float  q10 = input.float(0.0, "Shares · entry · first stop · stop now", minval = 0.0, group = G10, inline = "a10", tooltip = TIP_ROW, display = display.none)
float  p10 = input.float(0.0, "", minval = 0.0, group = G10, inline = "a10", display = display.none)
float  x10 = input.float(0.0, "", minval = 0.0, group = G10, inline = "a10", display = display.none)
float  y10 = input.float(0.0, "", minval = 0.0, group = G10, inline = "a10", display = display.none)
int    t10 = input.time(T0, "Entry date", group = G10, display = display.none)

string GL = "Look"
string i_tablePos  = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = GL, display = display.none)
string i_textSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = GL, display = display.none)
color  i_cAccentIn = input.color(#4C8BF5, "Accent", group = GL, tooltip = "On a light chart background the four colours are darkened so that small text stays readable.")
color  i_cStopIn   = input.color(#E5484D, "Stop", group = GL)
color  i_cGoodIn   = input.color(#2EBD85, "Good", group = GL)
color  i_cWarnIn   = input.color(#F0A030, "Warning", group = GL)

if not (timeframe.isdaily and timeframe.multiplier == 1)
    runtime.error("SL Portfolio Desk: use a daily chart (for example SPY).")
// the chart supplies the trading days: on a chart that trades on other days (crypto, forex, futures, another country) the
// positions' returns would be repeated or skipped and the alert would fire at that market's close
if not (syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index") or syminfo.timezone != "America/New_York"
    runtime.error("SL Portfolio Desk: use the daily chart of a US stock, ETF or index (for example SPY). The chart supplies the trading days.")

bool LIGHT_BG = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color) > 140
f_ink(color c) =>
    LIGHT_BG ? color.rgb(0.62 * color.r(c), 0.62 * color.g(c), 0.62 * color.b(c)) : c
color i_cAccent = f_ink(i_cAccentIn)
color i_cStop   = f_ink(i_cStopIn)
color i_cGood   = f_ink(i_cGoodIn)
color i_cWarn   = f_ink(i_cWarnIn)

// ─────────────────────────────────────────────────────────────── constants [C]
// Quantiles (5%, 25%, 75%, 95%) of the book's return over h daily bars divided by its predicted scale s_p
// (research/confirm/portfolio_band_constants.json; calibrated on 2011-2022, checked once on 2023-2026).
float PQ05 = i_hold == 5 ? -1.27 : i_hold == 10 ? -1.25 : -1.23
float PQ25 = i_hold == 5 ? -0.39 : i_hold == 10 ? -0.36 : -0.33
float PQ75 = i_hold == 5 ?  0.52 : i_hold == 10 ?  0.53 :  0.55
float PQ95 = i_hold == 5 ?  1.14 : i_hold == 10 ?  1.13 :  1.14
int   CORR_WINDOW = 60
int   SLOTS       = 10

// ─────────────────────────────────────────────────────────────── daily data of each position
// held: daily bars since the entry date, the entry day being day 1 (a bar counts when its trading day is the entry day or later)
f_pos(int entryTime) =>
    float a    = ta.atr(14)
    float held = ta.cum(time_tradingday >= entryTime - entryTime % 86400000 ? 1.0 : 0.0)
    [close, low, a, time, held, earnings.future_time]

// log return of a slot since the previous chart bar, only on the chart bars where that symbol printed a new daily bar
f_ret(float c, int tm) =>
    tm != tm[1] ? math.log(c / c[1]) : na

[c1, l1, a1, m1, h1, e1] = request.security(s1, "1D", f_pos(t1), ignore_invalid_symbol = true)
[c2, l2, a2, m2, h2, e2] = request.security(s2, "1D", f_pos(t2), ignore_invalid_symbol = true)
[c3, l3, a3, m3, h3, e3] = request.security(s3, "1D", f_pos(t3), ignore_invalid_symbol = true)
[c4, l4, a4, m4, h4, e4] = request.security(s4, "1D", f_pos(t4), ignore_invalid_symbol = true)
[c5, l5, a5, m5, h5, e5] = request.security(s5, "1D", f_pos(t5), ignore_invalid_symbol = true)
[c6, l6, a6, m6, h6, e6] = request.security(s6, "1D", f_pos(t6), ignore_invalid_symbol = true)
[c7, l7, a7, m7, h7, e7] = request.security(s7, "1D", f_pos(t7), ignore_invalid_symbol = true)
[c8, l8, a8, m8, h8, e8] = request.security(s8, "1D", f_pos(t8), ignore_invalid_symbol = true)
[c9, l9, a9, m9, h9, e9] = request.security(s9, "1D", f_pos(t9), ignore_invalid_symbol = true)
[c10, l10, a10, m10, h10, e10] = request.security(s10, "1D", f_pos(t10), ignore_invalid_symbol = true)

array<string> SYM  = array.from(s1, s2, s3, s4, s5, s6, s7, s8, s9, s10)
array<float>  QTY  = array.from(q1, q2, q3, q4, q5, q6, q7, q8, q9, q10)
array<float>  ENT  = array.from(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10)
array<float>  STP0 = array.from(x1, x2, x3, x4, x5, x6, x7, x8, x9, x10)                 // the first stop: defines 1 R
array<float>  STPN = array.from(y1 > 0 ? y1 : x1, y2 > 0 ? y2 : x2, y3 > 0 ? y3 : x3, y4 > 0 ? y4 : x4, y5 > 0 ? y5 : x5, y6 > 0 ? y6 : x6, y7 > 0 ? y7 : x7, y8 > 0 ? y8 : x8, y9 > 0 ? y9 : x9, y10 > 0 ? y10 : x10)   // the stop as it stands now
array<float>  CLS  = array.from(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10)
array<float>  LOW  = array.from(l1, l2, l3, l4, l5, l6, l7, l8, l9, l10)
array<float>  ATR  = array.from(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10)
array<float>  HLD  = array.from(h1, h2, h3, h4, h5, h6, h7, h8, h9, h10)
array<int>    ERN  = array.from(e1, e2, e3, e4, e5, e6, e7, e8, e9, e10)

// the last 60 daily log returns of every slot, one row per chart bar
var matrix<float> RM = matrix.new<float>(0, SLOTS, na)
RM.add_row(RM.rows(), array.from(f_ret(c1, m1), f_ret(c2, m2), f_ret(c3, m3), f_ret(c4, m4), f_ret(c5, m5), f_ret(c6, m6), f_ret(c7, m7), f_ret(c8, m8), f_ret(c9, m9), f_ret(c10, m10)))
if RM.rows() > CORR_WINDOW
    RM.remove_row(0)

f_corr(int i, int j) =>
    float sx  = 0.0
    float sy  = 0.0
    float sxx = 0.0
    float syy = 0.0
    float sxy = 0.0
    int   n   = 0
    if RM.rows() > 0
        for k = 0 to RM.rows() - 1
            float x = RM.get(k, i)
            float y = RM.get(k, j)
            if not na(x) and not na(y)
                sx  += x
                sy  += y
                sxx += x * x
                syy += y * y
                sxy += x * y
                n   += 1
    float vx = n > 0 ? sxx / n - math.pow(sx / n, 2) : 0.0
    float vy = n > 0 ? syy / n - math.pow(sy / n, 2) : 0.0
    // fewer than 20 common days: assume 0.3, the usual figure between two US stocks
    n >= 20 and vx > 0 and vy > 0 ? (sxy / n - sx / n * sy / n) / math.sqrt(vx * vy) : 0.3

// ─────────────────────────────────────────────────────────────── per position, then the book
f_name(int i) =>
    SYM.get(i) == "" ? syminfo.ticker : syminfo.ticker(SYM.get(i))

f_active(int i) =>
    QTY.get(i) > 0 and not na(CLS.get(i))

f_sessions(int i) =>
    int e = ERN.get(i)
    float d = na(e) ? na : (e - nz(time_close, timenow)) / 86400000.0
    not na(d) and d > -1.0 ? math.max(0.0, math.round(d * 5.0 / 7.0)) : na

// R against the FIRST stop; na while the entry or the first stop is missing or the stop is not below the entry
f_r(int i) =>
    float risk = ENT.get(i) - STP0.get(i)
    risk > 0 and STP0.get(i) > 0 ? (CLS.get(i) - ENT.get(i)) / risk : na

f_rTxt(int i) =>
    float r = f_r(i)
    na(r) ? "" : " (" + (r >= 0 ? "+" : "") + str.tostring(r, "0.##") + " R)"

float sqrtH    = math.sqrt(i_hold)
int   nActive  = 0
int   nNoData  = 0
int   noStop   = 0
float exposure = 0.0
float openRisk = 0.0
float result   = 0.0
float sumWu    = 0.0
array<float> WU = array.new<float>(SLOTS, 0.0)       // weight x band unit of each position: shares x ATR x sqrt(h) / equity
for i = 0 to SLOTS - 1
    if QTY.get(i) > 0 and na(CLS.get(i))
        nNoData += 1
    if f_active(i)
        nActive  += 1
        exposure += QTY.get(i) * CLS.get(i) / i_equity
        if STPN.get(i) > 0
            openRisk += QTY.get(i) * math.max(CLS.get(i) - STPN.get(i), 0.0) / i_equity
        else
            noStop += 1
        result   += ENT.get(i) > 0 ? QTY.get(i) * (CLS.get(i) - ENT.get(i)) : 0.0
        WU.set(i, QTY.get(i) * nz(ATR.get(i)) * sqrtH / i_equity)       // no ATR yet (fewer than 15 daily bars): left out of the range
        sumWu    += WU.get(i)

float varP   = 0.0
float rhoSum = 0.0
int   pairs  = 0
if barstate.islast or barstate.isrealtime
    for i = 0 to SLOTS - 1
        if WU.get(i) > 0
            varP += WU.get(i) * WU.get(i)
            if i < SLOTS - 1
                for j = i + 1 to SLOTS - 1
                    if WU.get(j) > 0
                        float rho = f_corr(i, j)
                        varP   += 2.0 * WU.get(i) * rho * WU.get(j)
                        rhoSum += rho
                        pairs  += 1
float sP      = varP > 0 ? math.sqrt(varP) : na            // predicted scale of the book's move over h bars, as a fraction of equity
float bandLo  = sP * PQ05
float bandHi  = sP * PQ95
float halfLo  = sP * PQ25
float halfHi  = sP * PQ75
float nEff    = varP > 0 ? sumWu * sumWu / varP : na       // 1 if the positions move as one, N if they are independent and equal
float rhoAvg  = pairs > 0 ? rhoSum / pairs : na
bool  hot     = 100.0 * openRisk > i_heatMax

// ─────────────────────────────────────────────────────────────── one alert for the whole book (at the daily close)
// Each message is sent once, when its state begins. The arrays keep the state of the previous bar.
var array<bool> wasInside  = array.new<bool>(SLOTS, false)
var array<bool> wasTimeUp  = array.new<bool>(SLOTS, false)
var array<bool> wasTouched = array.new<bool>(SLOTS, false)
var bool        wasHot     = false
string msg = ""
for i = 0 to SLOTS - 1
    bool  on      = f_active(i)
    float sess    = f_sessions(i)
    float left    = math.max(i_hold - nz(HLD.get(i)), 0.0)                         // bars still to be held
    bool  inside  = on and not na(sess) and (wasInside.get(i) or sess <= left)     // a report before the planned exit
    bool  timeUp  = on and nz(HLD.get(i)) >= i_hold
    bool  touched = on and nz(HLD.get(i)) >= 1 and STPN.get(i) > 0 and LOW.get(i) <= STPN.get(i)
    if touched and not wasTouched.get(i)
        msg += f_name(i) + ": traded at or below its stop " + str.tostring(STPN.get(i), format.mintick) + f_rTxt(i) + ".  "
    if timeUp and not wasTimeUp.get(i)
        msg += f_name(i) + ": day " + str.tostring(HLD.get(i), "0") + ", holding period complete" + f_rTxt(i) + ".  "
    if inside and not wasInside.get(i)
        msg += f_name(i) + ": earnings in about " + str.tostring(sess, "0") + " sessions, before the planned exit.  "
    wasInside.set(i, inside)
    wasTimeUp.set(i, timeUp)
    wasTouched.set(i, touched)
if hot and not wasHot
    msg += "Book: open risk to the stops " + str.tostring(100.0 * openRisk, "0.#") + "% of equity, above your limit of " + str.tostring(i_heatMax, "0.#") + "%.  "
wasHot := hot
if barstate.isconfirmed and msg != ""
    alert(msg, alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────── table (last bar)
f_tablePos(string s) =>
    s == "Top right" ? position.top_right : s == "Bottom right" ? position.bottom_right : s == "Top left" ? position.top_left : position.bottom_left

string TS      = i_textSize == "Tiny" ? size.tiny : i_textSize == "Small" ? size.small : size.normal
color  C_FG    = chart.fg_color
color  C_MUTED = color.new(chart.fg_color, 45)
string SEP     = " · "
int    COLS    = 7
int    ROWS    = 24
var table tb = na

f_cell(int col, int row, string txt, color c, string tip) =>
    table.cell(tb, col, row, txt, text_halign = col == 0 ? text.align_left : text.align_right, text_size = TS, text_color = c, tooltip = tip)

// a section title: plain cells with one background (a merged cell takes its width from its neighbours, not from its text)
f_section(int row, string title) =>
    color bg = color.new(i_cAccent, 88)
    table.cell(tb, 0, row, title, text_halign = text.align_left, text_size = TS, text_color = i_cAccent, bgcolor = bg, text_formatting = text.format_bold)
    for col = 1 to COLS - 1
        table.cell(tb, col, row, "", text_size = TS, bgcolor = bg)

// a book row: label, a short value across the five middle columns, tag
f_wide(int row, string k, string v, color vc, string tag, string tip) =>
    table.cell(tb, 0, row, k, text_halign = text.align_left, text_size = TS, text_color = C_MUTED, tooltip = tip)
    table.cell(tb, 1, row, v, text_halign = text.align_left, text_size = TS, text_color = vc, tooltip = tip)
    table.merge_cells(tb, 1, row, COLS - 2, row)
    table.cell(tb, COLS - 1, row, tag, text_halign = text.align_center, text_size = TS, text_color = tag == "C" ? i_cGood : C_MUTED,
         tooltip = tag == "C" ? "Checked once on 2023-2026 with constants committed beforehand; not part of the pre-registered list." : "")

f_pct(float x, string fmt) =>
    na(x) ? "-" : (x >= 0 ? "+" : "") + str.tostring(100.0 * x, fmt) + "%"

f_money(float x) =>
    na(x) ? "-" : (x >= 0 ? "+" : "") + str.format("{0,number,integer}", x)

if barstate.islast
    // a fresh table on every update: each cell range is merged once per table
    if not na(tb)
        table.delete(tb)
    tb := table.new(f_tablePos(i_tablePos), COLS, ROWS, bgcolor = color.new(chart.bg_color, 6), frame_color = color.new(chart.fg_color, 78),
         frame_width = 1, border_width = 0)
    string hb = str.tostring(i_hold) + " bars"
    int row = 0
    color hbg = nNoData > 0 ? i_cStop : i_cAccent
    table.cell(tb, 0, row, "SL PORTFOLIO DESK", text_halign = text.align_left, text_size = TS, text_color = color.white, bgcolor = hbg, text_formatting = text.format_bold)
    table.cell(tb, 1, row, nActive == 0 and nNoData == 0 ? "" : str.tostring(nActive) + (nActive == 1 ? " position" : " positions") + SEP + "hold " + hb +
         (nNoData > 0 ? SEP + str.tostring(nNoData) + " WITHOUT DATA" : ""), text_halign = text.align_left, text_size = TS, text_color = color.white, bgcolor = hbg)
    table.merge_cells(tb, 1, row, COLS - 1, row)
    row += 1
    if nActive == 0 and nNoData == 0
        table.cell(tb, 0, row, "No positions yet.\nSettings > Inputs > Position 1:\nsymbol, shares, entry, first stop, date.", text_halign = text.align_left,
             text_size = TS, text_color = i_cWarn, tooltip = "A row is on when its shares are above 0.")
        row += 1
    else
        f_cell(0, row, "Position", C_MUTED, "")
        f_cell(1, row, "% of equity", C_MUTED, "Shares x last close / account equity.")
        f_cell(2, row, "Result", C_MUTED, "R = (close - entry) / (entry - first stop).")
        f_cell(3, row, "Day", C_MUTED, "Daily bars since the entry date, entry day = 1, of the holding period.")
        f_cell(4, row, "At risk", C_MUTED, "What the position gives up from the last close if its stop (as it stands now) fills at its price, as % of equity. Profit not yet taken counts. 0 only when the close is at or below the stop.")
        f_cell(5, row, "Earnings", C_MUTED, "Sessions to the next report (estimated from calendar days). Date read when the script loads. Check it once against the stock's own chart: reading another symbol's date this way is not documented by TradingView. A dash means no date reached this script.")
        table.cell(tb, 6, row, "Status", text_halign = text.align_center, text_size = TS, text_color = C_MUTED)
        row += 1
        for i = 0 to SLOTS - 1
            if QTY.get(i) > 0 and not f_active(i)
                f_cell(0, row, f_name(i), C_FG, "")
                table.cell(tb, 6, row, "NO DATA", text_halign = text.align_center, text_size = TS, text_color = i_cStop, bgcolor = color.new(i_cStop, 85),
                     tooltip = "No daily data reached this script for this symbol. It is NOT counted in the book figures below. Check the symbol.")
                row += 1
            if f_active(i)
                float rNow    = f_r(i)
                float sess    = f_sessions(i)
                bool  inside  = wasInside.get(i)
                bool  timeUp  = nz(HLD.get(i)) >= i_hold
                bool  touched = wasTouched.get(i)
                bool  setup   = na(rNow)
                bool  stale   = na(sess) and not na(ERN.get(i))
                float atRisk  = STPN.get(i) > 0 ? 100.0 * QTY.get(i) * math.max(CLS.get(i) - STPN.get(i), 0.0) / i_equity : na
                f_cell(0, row, f_name(i), C_FG, str.tostring(QTY.get(i), "0.##") + " shares" + SEP + "entry " + str.tostring(ENT.get(i), format.mintick) + SEP + "first stop " +
                     str.tostring(STP0.get(i), format.mintick) + SEP + "stop now " + str.tostring(STPN.get(i), format.mintick) + SEP + "last " + str.tostring(CLS.get(i), format.mintick))
                f_cell(1, row, str.tostring(100.0 * QTY.get(i) * CLS.get(i) / i_equity, "0.#") + "%", C_FG, "")
                f_cell(2, row, setup ? "-" : (rNow >= 0 ? "+" : "") + str.tostring(rNow, "0.##") + " R", setup ? C_MUTED : rNow >= 0 ? i_cGood : i_cStop, "")
                f_cell(3, row, nz(HLD.get(i)) >= 1 ? str.tostring(HLD.get(i), "0") + " / " + str.tostring(i_hold) : "-", timeUp ? i_cWarn : C_FG, "")
                f_cell(4, row, na(atRisk) ? "no stop" : str.tostring(atRisk, "0.##") + "%", na(atRisk) ? i_cWarn : C_FG, "")
                f_cell(5, row, stale ? "passed" : na(sess) ? "-" : str.tostring(sess, "0"), inside ? i_cStop : C_FG,
                     inside ? "Before the planned exit: about 1 report in 10 gaps more than 2 ATR against the holder." :
                     stale ? "The date read when the script loaded has passed. Reload the indicator, or create the alert again, to read the next one." : "")
                string st = touched ? "STOP TOUCHED" : setup ? "CHECK INPUTS" : inside ? "EARNINGS" : timeUp ? "TIME UP" : "ok"
                color  sc = touched ? i_cStop : setup or inside or timeUp ? i_cWarn : i_cGood
                table.cell(tb, 6, row, st, text_halign = text.align_center, text_size = TS, text_color = sc, bgcolor = color.new(sc, 85),
                     tooltip = setup ? "The entry price must be above 0 and the first stop between 0 and the entry price." : "")
                row += 1
        f_section(row, "BOOK")
        row += 1
        f_wide(row, "Invested", str.tostring(100.0 * exposure, "0.#") + "%" + SEP + "result " + f_money(result), exposure > 1.0 ? i_cWarn : C_FG, "",
             "Sum of the positions' values as % of account equity (above 100% the book is leveraged), and the money made or lost so far.")
        row += 1
        f_wide(row, "Open risk", str.tostring(100.0 * openRisk, "0.##") + "%" + SEP + "limit " + str.tostring(i_heatMax, "0.#") + "%" +
             (noStop > 0 ? SEP + str.tostring(noStop) + " without a stop" : ""), hot or noStop > 0 ? i_cStop : C_FG, "",
             "What the book loses, as % of equity, if every stop fills at its price: the sum of the 'At risk' column. Arithmetic, and a floor, not a ceiling: about 15% of stops fill below their price, and with a 2 ATR stop held 10 bars about 1 trade in 100 loses more than 1.5 times its planned risk (both demonstrated on 2023-2026). A position without a stop is not counted.")
        row += 1
        f_wide(row, "Range, 9 in 10", na(sP) ? "-" : f_pct(bandLo, "0.#") + " to " + f_pct(bandHi, "0.#") + SEP + f_money(bandLo * i_equity) + " to " + f_money(bandHi * i_equity), C_FG, "C",
             "As % of equity, then in money: how far the whole book usually moves over the next " + hb + " if nothing is sold, given each position's ATR and how the positions have moved together over the last 60 days. On 2023-2026 this band held 88.9% to 90.2% of outcomes for books of 2 to 10 positions. Stops are ignored. It does not capture a crash, when everything falls together.")
        row += 1
        f_wide(row, "Range, 1 in 2", na(sP) ? "-" : f_pct(halfLo, "0.#") + " to " + f_pct(halfHi, "0.#"), C_FG, "C",
             "As % of equity. On 2023-2026 this band held 45.9% to 49.8% of outcomes.")
        row += 1
        f_wide(row, "Diversification", na(nEff) ? "-" : "like " + str.tostring(nEff, "0.#") + " independent, of " + str.tostring(nActive) +
             (na(rhoAvg) ? "" : SEP + "corr " + str.tostring(rhoAvg, "0.##")), not na(rhoAvg) and nActive >= 3 and rhoAvg > 0.5 ? i_cWarn : C_FG, "",
             "The number of independent positions the book behaves like, and the average correlation of the last 60 daily returns. Arithmetic. With the usual correlation of 0.3, five stocks behave like about 2.3 and ten like about 2.7: that is normal. Above 0.5 the book is close to one bet.")
        row += 1
    if nActive > 0 or nNoData > 0
        table.cell(tb, 0, row, "C checked once on 2023-26" + SEP + "daily values, final at the close" + SEP + "hover a cell", text_halign = text.align_left, text_size = size.tiny,
             text_color = C_MUTED)
        table.merge_cells(tb, 0, row, COLS - 1, row)

// ─────────────────────────────────────────────────────────────── values for the Data Window and CSV export
plot(nActive,            "Positions",               display = display.data_window)
plot(100.0 * exposure,   "Invested pct of equity",  display = display.data_window)
plot(100.0 * openRisk,   "Open risk pct of equity", display = display.data_window)
plot(100.0 * bandLo,     "Book band 5pct",          display = display.data_window)
plot(100.0 * bandHi,     "Book band 95pct",         display = display.data_window)
plot(nEff,               "Independent positions",   display = display.data_window)
plot(rhoAvg,             "Average correlation",     display = display.data_window)
