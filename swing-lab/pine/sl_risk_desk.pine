//@version=6
// SL Risk Desk (swing-lab), version 2.1
//
// For the stock on the chart: how many shares fit my risk budget, where a stop k ATR away sits and how often
// such a stop is hit by noise, how far the price usually travels over my holding period, whether an earnings
// report falls inside that period, and whether the index is in its high-volatility state.
// It gives no buy or sell signal: in the research behind it (about 64,000 tests on US stocks, 1998-2026) no
// chart rule that picks stocks or times entries survived out-of-sample testing.
//
// Evidence tags (swing-lab/docs/RESEARCH_LOG.md, entry 7):
//   D  demonstrated out of sample: frozen before, and passed on, data set aside for 2023-2026
//   S  suggestive: held on validation data, not confirmed on the set-aside data
//   U  untested: calibrated on all data
//
// All values come from DAILY bars. Daily chart: the chart's own bar, final at its close. Intraday chart: the
// last completed day. Weekly or monthly chart: the last daily bar inside the chart bar. Alerts fire once, at a
// bar's close.
indicator("SL Risk Desk", shorttitle = "SL Risk Desk", overlay = true, max_lines_count = 60, max_labels_count = 60)

// ─────────────────────────────────────────────────────────────── inputs
string G1 = "1 · Plan for a new trade"
float  i_equity  = input.float(100000.0, "Account equity", minval = 0.0, step = 1000.0, group = G1, tooltip = "In the currency of the chart.")
float  i_riskPct = input.float(0.75, "Risk per trade, % of equity", minval = 0.05, maxval = 5.0, step = 0.05, group = G1,
     tooltip = "What you lose if the stop is filled at its price. About 1 trade in 100 loses more than 1.5 times this, because prices gap through stops.")
float  i_stopK   = input.float(3.0, "Stop distance, in daily ATR(14)", minval = 1.0, maxval = 4.0, step = 0.25, group = G1,
     tooltip = "Measured below the entry price. A wider stop buys fewer shares: the money at risk stays the same.")
int    i_hold    = input.int(10, "Holding period, daily bars", options = [5, 10, 20], group = G1)
float  i_maxPos  = input.float(20.0, "Largest position, % of equity", minval = 1.0, maxval = 100.0, group = G1,
     tooltip = "A cap for quiet stocks, where the risk budget alone would buy too much.")

string G2 = "2 · Open position (fill in after you buy)"
bool   i_inPos      = input.bool(false, "I hold this stock", group = G2)
float  i_entryPx    = input.float(0.0, "Entry price", minval = 0.0, group = G2)
float  i_stopHeld   = input.float(0.0, "Stop price", minval = 0.0, group = G2)
float  i_sharesHeld = input.float(0.0, "Shares held (optional)", minval = 0.0, group = G2)
int    i_entryTime  = input.time(timestamp("2026-01-02T00:00:00"), "Entry date", group = G2)

string G3 = "3 · Alerts"
bool   i_planAlert = input.bool(false, "Send the plan at each daily close", group = G3,
     tooltip = "For a stock you intend to buy at the next open. Daily chart only. Create one alert on this indicator with the condition 'Any alert() function call'.")

string G4 = "4 · Look"
bool   i_showCone  = input.bool(true, "Range cone for the holding period", group = G4)
bool   i_showEnv   = input.bool(false, "Envelope: where earlier bands said today's close would be", group = G4,
     tooltip = "The 90% band drawn h bars ago, plotted at the bar it was aiming at. A dot marks a close outside it: about 1 bar in 10. It is a report card for the bands, not a signal. It widens the price scale, so it is off by default.")
bool   i_showStop  = input.bool(true, "Stop level", group = G4)
string i_tableMode = input.string("Full", "Table", options = ["Full", "Compact", "Off"], group = G4)
string i_tablePos  = input.string("Bottom left", "Table position", options = ["Bottom left", "Bottom right", "Top left", "Top right"], group = G4,
     tooltip = "Bottom left keeps the table away from the cone and the stop. Top left sits under the chart's own legend.")
string i_textSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G4)
color  i_cAccent   = input.color(#4C8BF5, "Accent", group = G4)
color  i_cStop     = input.color(#E5484D, "Stop", group = G4)
color  i_cGood     = input.color(#2EBD85, "Good", group = G4)
color  i_cWarn     = input.color(#F0A030, "Warning", group = G4)

string G5 = "5 · Market"
string i_mkt = input.symbol("AMEX:SPY", "Index reference", group = G5)

if not chart.is_standard
    runtime.error("SL Risk Desk: use a standard chart (candles, bars or line). Heikin Ashi, Renko and similar charts carry synthetic prices.")

// ─────────────────────────────────────────────────────────────── constants [D]
// Where the close lands h daily bars later: quantiles of  ln(close[t+h] / close[t]) / (ATR14[t] / close[t] * sqrt(h)).
float Q05 = i_hold == 5 ? -1.23 : i_hold == 10 ? -1.26 : -1.28
float Q25 = -0.40
float Q75 = i_hold == 5 ?  0.45 : i_hold == 10 ?  0.47 :  0.49
float Q95 = i_hold == 5 ?  1.10 : i_hold == 10 ?  1.10 :  1.11

// Share of entries (at the next open) whose stop k x ATR(14) below the entry is hit within h daily bars.
f_stopOdds(float k, int h) =>
    array<float> ks  = array.from(1.0, 1.5, 2.0, 2.5, 3.0, 4.0)
    array<float> p5  = array.from(0.458, 0.288, 0.176, 0.107, 0.066, 0.028)
    array<float> p10 = array.from(0.599, 0.445, 0.324, 0.233, 0.165, 0.083)
    array<float> p20 = array.from(0.710, 0.584, 0.475, 0.381, 0.303, 0.188)
    array<float> p   = h == 5 ? p5 : h == 10 ? p10 : p20
    float kk  = math.max(1.0, math.min(4.0, k))
    float res = p.get(5)
    for i = 0 to 4
        float k0 = ks.get(i)
        float k1 = ks.get(i + 1)
        if kk >= k0 and kk <= k1
            res := p.get(i) + (p.get(i + 1) - p.get(i)) * (kk - k0) / (k1 - k0)
            break
    res

// Earnings night: opening gap against the holder, in daily ATR(14). The multiple over an ordinary night is [D]
// (at least 20 times; measured 48 times in 2018-22 and 104 times in 2023-26). The odds are [U]: all reports
// 2017-2026; by year they range from 15% to 27%, 5% to 15% and 3% to 8%.
float E_GAP1 = 0.20
float E_GAP2 = 0.10
float E_GAP3 = 0.05

float UNIVERSE_DOLLAR_VOLUME = 20000000.0
float UNIVERSE_PRICE         = 5.0

// ─────────────────────────────────────────────────────────────── daily core
f_core() =>
    float a  = ta.atr(14)
    float c  = close
    float dv = ta.median(close * volume, 60)
    // this symbol's own record: where did the close land h bars after each band was drawn?
    float uAgo = a[i_hold] / c[i_hold] * math.sqrt(i_hold)
    float y    = math.log(c / c[i_hold]) / uAgo
    bool  have = not na(y)
    float n    = ta.cum(have ? 1.0 : 0.0)
    float in90 = ta.cum(have and y >= Q05 and y <= Q95 ? 1.0 : 0.0)
    float in50 = ta.cum(have and y >= Q25 and y <= Q75 ? 1.0 : 0.0)
    // and how often was a stop k ATR below the next open hit within h bars?
    float lowest  = ta.lowest(low, i_hold)
    float stopLvl = open[i_hold - 1] - i_stopK * a[i_hold]
    bool  haveS   = not na(stopLvl)
    float nS      = ta.cum(haveS ? 1.0 : 0.0)
    float hits    = ta.cum(haveS and lowest <= stopLvl ? 1.0 : 0.0)
    float held    = ta.cum(i_inPos and time >= i_entryTime ? 1.0 : 0.0)
    // the bands drawn h bars ago, which were aiming at this bar
    float e05 = c[i_hold] * math.exp(Q05 * uAgo)
    float e25 = c[i_hold] * math.exp(Q25 * uAgo)
    float e75 = c[i_hold] * math.exp(Q75 * uAgo)
    float e95 = c[i_hold] * math.exp(Q95 * uAgo)
    [a, c, dv, n, in90, in50, nS, hits, held, e05, e25, e75, e95]

f_prev() =>
    [a, c, dv, n, in90, in50, nS, hits, held, e05, e25, e75, e95] = f_core()
    [a[1], c[1], dv[1], n[1], in90[1], in50[1], nS[1], hits[1], held[1], e05[1], e25[1], e75[1], e95[1]]

f_mkt() =>
    float m = ta.sma(close, 200)
    [close, m]

f_mktPrev() =>
    [c, m] = f_mkt()
    [c[1], m[1]]

int    tfSec   = timeframe.in_seconds()
bool   isDaily = tfSec == 86400
bool   isIntra = tfSec < 86400
string symD    = ticker.modify(syminfo.tickerid, session.regular)

[a0, c0, dv0, n0, in90_0, in50_0, nS0, hits0, held0, e05_0, e25_0, e75_0, e95_0] = f_core()
[a1, c1, dv1, n1, in90_1, in50_1, nS1, hits1, held1, e05_1, e25_1, e75_1, e95_1] = request.security(symD, "1D", f_prev(), lookahead = barmerge.lookahead_on)
[a2, c2, dv2, n2, in90_2, in50_2, nS2, hits2, held2, e05_2, e25_2, e75_2, e95_2] = request.security(symD, "1D", f_core())

float atrD   = isDaily ? a0     : isIntra ? a1     : a2
float closeD = isDaily ? c0     : isIntra ? c1     : c2
float dvMed  = isDaily ? dv0    : isIntra ? dv1    : dv2
float nAud   = isDaily ? n0     : isIntra ? n1     : n2
float in90   = isDaily ? in90_0 : isIntra ? in90_1 : in90_2
float in50   = isDaily ? in50_0 : isIntra ? in50_1 : in50_2
float nStop  = isDaily ? nS0    : isIntra ? nS1    : nS2
float hits   = isDaily ? hits0  : isIntra ? hits1  : hits2
float held   = isDaily ? held0  : isIntra ? held1  : held2
float env05  = isDaily ? e05_0  : isIntra ? e05_1  : e05_2
float env25  = isDaily ? e25_0  : isIntra ? e25_1  : e25_2
float env75  = isDaily ? e75_0  : isIntra ? e75_1  : e75_2
float env95  = isDaily ? e95_0  : isIntra ? e95_1  : e95_2

[mc1, mm1] = request.security(i_mkt, "1D", f_mktPrev(), lookahead = barmerge.lookahead_on)
[mc2, mm2] = request.security(i_mkt, "1D", f_mkt())
float mktClose = isIntra ? mc1 : mc2
float mktAvg   = isIntra ? mm1 : mm2
bool  mktKnown = not na(mktClose) and not na(mktAvg)
bool  mktUp    = mktKnown and mktClose > mktAvg

// ─────────────────────────────────────────────────────────────── the plan
float px        = close
float stopDist  = i_stopK * atrD
float stopPx    = px - stopDist
float riskCash  = i_equity * i_riskPct / 100.0
float sharesRaw = stopDist > 0 ? riskCash / stopDist : na
float sharesCap = px > 0 ? i_equity * i_maxPos / 100.0 / px : na
float shares    = math.floor(math.min(sharesRaw, sharesCap))
bool  capped    = sharesRaw > sharesCap
float posValue  = shares * px
float posPct    = i_equity > 0 ? 100.0 * posValue / i_equity : na
float riskTaken = shares * stopDist
float pStop     = f_stopOdds(i_stopK, i_hold)

float unit = atrD / closeD * math.sqrt(i_hold)          // one unit of the band scale, as a log return
float lo05 = px * math.exp(Q05 * unit)
float lo25 = px * math.exp(Q25 * unit)
float hi75 = px * math.exp(Q75 * unit)
float hi95 = px * math.exp(Q95 * unit)

float cov90   = nAud > 0 ? 100.0 * in90 / nAud : na
float cov50   = nAud > 0 ? 100.0 * in50 / nAud : na
float covStop = nStop > 0 ? 100.0 * hits / nStop : na

bool isStock    = syminfo.type == "stock" or syminfo.type == "dr"
bool inUniverse = isStock and dvMed >= UNIVERSE_DOLLAR_VOLUME and closeD >= UNIVERSE_PRICE

// ─────────────────────────────────────────────────────────────── earnings
// earnings.future_time is read when the script loads. An alert created today knows the next report only.
int   nextE    = earnings.future_time
float daysToE  = na(nextE) ? na : (nextE - time_close) / 86400000.0
bool  eKnown   = not na(daysToE) and daysToE > -1.0
float sessToE  = eKnown ? math.max(0.0, math.round(daysToE * 5.0 / 7.0)) : na      // calendar days to sessions, approximate
bool  eInside  = eKnown and sessToE <= i_hold

// ─────────────────────────────────────────────────────────────── open position
bool  posOn    = i_inPos and i_entryPx > 0 and i_stopHeld > 0 and i_stopHeld < i_entryPx and time >= i_entryTime
float riskPS   = i_entryPx - i_stopHeld
float rNow     = posOn ? (close - i_entryPx) / riskPS : na
bool  stopHit  = posOn and low <= i_stopHeld
bool  timeUp   = posOn and held >= i_hold
var int entryBar = na
if i_inPos and na(entryBar) and time >= i_entryTime
    entryBar := bar_index

// ─────────────────────────────────────────────────────────────── alerts (once, at the bar's close)
if barstate.isconfirmed
    if mktKnown and mktKnown[1] and mktUp != mktUp[1]
        alert(str.format("{0}: closed {1} its 200-day average. Index volatility has been about twice as high below it [S].",
             syminfo.ticker(i_mkt), mktUp ? "ABOVE" : "BELOW"), alert.freq_once_per_bar_close)
    if eInside and not eInside[1]
        alert(str.format("{0}: earnings report in about {1} sessions, inside a {2}-bar holding period. About 1 report in 10 gaps more than 2 ATR against the holder.",
             syminfo.ticker, str.tostring(sessToE, "#"), str.tostring(i_hold)), alert.freq_once_per_bar_close)
    if i_planAlert and isDaily and not i_inPos and not na(shares)
        alert(str.format("{0} plan for the next open: {1} shares, stop {2} below the fill (about {3}), hit within {4} bars {5}% of the time. 90% band {6} to {7}. Earnings: {8}. {9}",
             syminfo.ticker, str.format("{0,number,integer}", shares), str.tostring(stopDist, format.mintick), str.tostring(stopPx, format.mintick), str.tostring(i_hold),
             str.tostring(100.0 * pStop, "#"), str.tostring(lo05, format.mintick), str.tostring(hi95, format.mintick),
             not eKnown ? "no date on file" : eInside ? "INSIDE the holding period, in about " + str.tostring(sessToE, "#") + " sessions" : "outside the holding period",
             inUniverse ? "" : "Outside the tested universe."), alert.freq_once_per_bar_close)
    if stopHit
        alert(str.format("{0}: traded at or below your stop {1}. Position at {2} R.", syminfo.ticker, str.tostring(i_stopHeld, format.mintick),
             str.tostring(rNow, "#.##")), alert.freq_once_per_bar_close)
    if timeUp and not timeUp[1]
        alert(str.format("{0}: {1} daily bars held, the planned holding period is complete. Position at {2} R.", syminfo.ticker,
             str.tostring(held, "#"), str.tostring(rNow, "#.##")), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────── envelope: the report card of the bands
// Plotted only when asked for: a visible plot stretches the price scale, an na plot does not.
plotLo = plot(i_showEnv ? env05 : na, "Envelope, lower line", color = color.new(i_cAccent, 60), linewidth = 1)
plotHi = plot(i_showEnv ? env95 : na, "Envelope, upper line", color = color.new(i_cAccent, 60), linewidth = 1)
fill(plotLo, plotHi, color = color.new(i_cAccent, 94), title = "Envelope")
plotshape(i_showEnv and isDaily and close > env95, "Close above the envelope", style = shape.circle, location = location.abovebar,
     color = color.new(i_cWarn, 15), size = size.tiny)
plotshape(i_showEnv and isDaily and close < env05, "Close below the envelope", style = shape.circle, location = location.belowbar,
     color = color.new(i_cWarn, 15), size = size.tiny)
bgcolor(posOn ? color.new(i_cAccent, 95) : na, title = "Bars held")

// ─────────────────────────────────────────────────────────────── drawings (last bar)
var array<line>     gLines = array.new<line>()
var array<label>    gLabels = array.new<label>()
var array<linefill> gFills = array.new<linefill>()

f_clearDrawings() =>
    for x in gFills
        linefill.delete(x)
    for x in gLines
        line.delete(x)
    for x in gLabels
        label.delete(x)
    gFills.clear()
    gLines.clear()
    gLabels.clear()

// labels sit to the LEFT of their anchor, above the upper lines and below the lower ones, so they stay inside the
// chart's right margin and never lie on a line
f_tag(int x, float y, string txt, color c, bool above) =>
    gLabels.push(label.new(x, y, txt, style = above ? label.style_label_lower_right : label.style_label_upper_right, color = color.new(c, 100),
         textcolor = c, size = size.small))

// R of a price level: against the planned stop before the trade, against the real entry and stop once in it
f_rOf(float level) =>
    posOn ? (level - i_entryPx) / riskPS : stopDist > 0 ? (level - px) / stopDist : na

f_signed(float x) =>
    na(x) ? "-" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##")

f_rText(float level) =>
    float r = f_rOf(level)
    na(r) ? "" : "   " + f_signed(r) + " R"

if barstate.islast
    f_clearDrawings()
    int span = isDaily ? i_hold : 12
    int x0   = bar_index
    int x1   = bar_index + span
    if i_showCone and not na(lo05)
        // daily chart: from today's close to the band h bars ahead. Other timeframes: the levels, to the right of the last bar
        line ln05 = line.new(x0, isDaily ? px : lo05, x1, lo05, color = color.new(i_cAccent, 30), width = 1)
        line ln95 = line.new(x0, isDaily ? px : hi95, x1, hi95, color = color.new(i_cAccent, 30), width = 1)
        line ln25 = line.new(x0, isDaily ? px : lo25, x1, lo25, color = color.new(i_cAccent, 55), style = line.style_dotted)
        line ln75 = line.new(x0, isDaily ? px : hi75, x1, hi75, color = color.new(i_cAccent, 55), style = line.style_dotted)
        gLines.push(ln05), gLines.push(ln95), gLines.push(ln25), gLines.push(ln75)
        gFills.push(linefill.new(ln05, ln95, color.new(i_cAccent, 90)))
        gFills.push(linefill.new(ln25, ln75, color.new(i_cAccent, 84)))
        f_tag(x1, hi95, "95%   " + str.tostring(hi95, format.mintick) + f_rText(hi95), i_cAccent, true)
        f_tag(x1, hi75, "75%   " + str.tostring(hi75, format.mintick), color.new(i_cAccent, 35), true)
        f_tag(x1, lo25, "25%   " + str.tostring(lo25, format.mintick), color.new(i_cAccent, 35), false)
        f_tag(x1, lo05, "5%   " + str.tostring(lo05, format.mintick) + f_rText(lo05), i_cAccent, false)
        if isDaily and eInside and nextE > time
            gLines.push(line.new(nextE, lo05, nextE, hi95, xloc = xloc.bar_time, color = color.new(i_cWarn, 20), style = line.style_dashed, width = 1))
            gLabels.push(label.new(nextE, hi95, "Earnings", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(i_cWarn, 80),
                 textcolor = i_cWarn, size = size.small))
    int xPos = posOn and not na(entryBar) ? math.max(entryBar, bar_index - 400) : bar_index - 4
    if i_showStop and not na(stopPx)
        float s = posOn ? i_stopHeld : stopPx
        gLines.push(line.new(xPos, s, x1, s, color = color.new(i_cStop, 10), style = line.style_dashed, width = 2))
        gLabels.push(label.new(xPos, s, "Stop   " + str.tostring(s, format.mintick) + (posOn ? "" : "   ·   " + str.tostring(i_stopK, "#.##") + " ATR"),
             style = label.style_label_upper_right, color = color.new(i_cStop, 100), textcolor = i_cStop, size = size.small))
    if posOn and not na(entryBar)
        gLines.push(line.new(xPos, i_entryPx, x1, i_entryPx, color = color.new(i_cAccent, 20), width = 1))
        gLabels.push(label.new(xPos, i_entryPx, "Entry   " + str.tostring(i_entryPx, format.mintick), style = label.style_label_right,
             color = color.new(i_cAccent, 100), textcolor = i_cAccent, size = size.small))
        if isDaily
            int xt = entryBar + i_hold - 1
            if xt >= bar_index - 400 and xt <= bar_index + 400
                gLines.push(line.new(xt, i_stopHeld, xt, math.max(hi95, i_entryPx), color = color.new(chart.fg_color, 55), style = line.style_dotted))
                gLabels.push(label.new(xt, i_stopHeld, "day " + str.tostring(i_hold), style = label.style_label_up, color = color.new(chart.fg_color, 100),
                     textcolor = color.new(chart.fg_color, 30), size = size.small))

// ─────────────────────────────────────────────────────────────── table (last bar)
f_tablePos(string s) =>
    s == "Top right" ? position.top_right : s == "Bottom right" ? position.bottom_right : s == "Top left" ? position.top_left : position.bottom_left

string TS      = i_textSize == "Tiny" ? size.tiny : i_textSize == "Small" ? size.small : size.normal
color  C_FG    = chart.fg_color
color  C_MUTED = color.new(chart.fg_color, 45)

int TABLE_ROWS = 20
var table tb = na

f_section(int r, string title) =>
    table.cell(tb, 0, r, title, text_halign = text.align_left, text_size = TS, text_color = i_cAccent, bgcolor = color.new(i_cAccent, 88))
    table.merge_cells(tb, 0, r, 2, r)

f_row(int r, string k, string v, color vc, string tag, string tip) =>
    color tc = tag == "D" ? i_cGood : tag == "S" ? i_cWarn : C_MUTED
    table.cell(tb, 0, r, k, text_halign = text.align_left, text_size = TS, text_color = C_MUTED, tooltip = tip)
    table.cell(tb, 1, r, v, text_halign = text.align_left, text_size = TS, text_color = vc, tooltip = tip)
    table.cell(tb, 2, r, tag, text_halign = text.align_center, text_size = TS, text_color = tc,
         tooltip = tag == "D" ? "Demonstrated out of sample: frozen before, and passed on, data set aside for 2023-2026." :
         tag == "S" ? "Suggestive: held on validation data, not confirmed on the set-aside data." :
         tag == "U" ? "Untested: calibrated on all data." : "")

f_int(float x) =>
    na(x) ? "-" : str.format("{0,number,integer}", x)

if barstate.islast and i_tableMode != "Off"
    // a fresh table on every update: no stale rows or merged cells when the layout changes
    if not na(tb)
        table.delete(tb)
    tb := table.new(f_tablePos(i_tablePos), 3, TABLE_ROWS, bgcolor = color.new(chart.bg_color, 6), frame_color = color.new(chart.fg_color, 78),
         frame_width = 1, border_width = 0)
    bool   full = i_tableMode == "Full"
    string hb   = str.tostring(i_hold) + " bars"
    string cur  = syminfo.currency
    string SEP  = "  ·  "
    int    r    = 0
    table.cell(tb, 0, r, "SL RISK DESK", text_halign = text.align_left, text_size = TS, text_color = color.white, bgcolor = i_cAccent)
    table.cell(tb, 1, r, syminfo.ticker + SEP + "hold " + hb + SEP + "stop " + str.tostring(i_stopK, "#.##") + " ATR", text_halign = text.align_left,
         text_size = TS, text_color = color.white, bgcolor = i_cAccent)
    table.cell(tb, 2, r, "", bgcolor = i_cAccent)
    r += 1
    if i_inPos
        f_section(r, "POSITION")
        r += 1
        if posOn
            f_row(r, "Now", f_signed(rNow) + " R" + SEP + "day " + str.tostring(held, "#") + " of " + str.tostring(i_hold) +
                 (timeUp ? SEP + "TIME UP" : ""), stopHit ? i_cStop : timeUp ? i_cWarn : rNow >= 0 ? i_cGood : C_FG, "",
                 "R = (price - entry) / (entry - stop). Day 1 is the entry day. At the end of the holding period, exit or start a new period with new numbers.")
            r += 1
            f_row(r, "Entry / stop", str.tostring(i_entryPx, format.mintick) + " / " + str.tostring(i_stopHeld, format.mintick) + SEP + "1 R = " +
                 str.tostring(riskPS, format.mintick), C_FG, "", "The entry and stop you typed in. The real stop is an order at your broker; the alert is a backstop.")
            r += 1
            if full and i_sharesHeld > 0
                f_row(r, "Result", f_int(i_sharesHeld * (close - i_entryPx)) + " " + cur + SEP + "at the stop " + f_int(i_sharesHeld * (i_stopHeld - i_entryPx)), C_FG, "",
                     "Shares held x (price - entry), and what the position ends at if the stop fills at its price.")
                r += 1
        else
            f_row(r, "Setup", "type in the entry, a stop below it and the date", i_cWarn, "", "Settings > Inputs > Open position.")
            r += 1
    else
        f_section(r, "PLAN" + SEP + "if bought at the next open")
        r += 1
        f_row(r, "Buy", f_int(shares) + " shares" + SEP + f_int(posValue) + " " + cur + SEP + str.tostring(posPct, "#.#") + "%" + (capped ? " (capped)" : ""),
             capped ? i_cWarn : C_FG, "", "Shares = risk budget / stop distance, capped by the largest position. Every position then risks the same money, whatever the stock. The percentage is the share of account equity.")
        r += 1
        f_row(r, "Stop", str.tostring(stopPx, format.mintick) + SEP + str.tostring(stopDist, format.mintick) + " below the fill", C_FG, "",
             "Place the stop this distance below your actual fill, not below today's close. That is " + str.tostring(100.0 * stopDist / px, "#.#") + "% of the price.")
        r += 1
        if full
            f_row(r, "At risk", f_int(riskTaken) + " " + cur + SEP + str.tostring(i_equity > 0 ? 100.0 * riskTaken / i_equity : na, "#.##") + "% of equity", C_FG, "",
                 "What the trade loses if the stop fills at its price. About 15% of stops fill below it, and about 1 trade in 100 loses more than 1.5 times this.")
            r += 1
        f_row(r, "Stop hit by noise", str.tostring(100.0 * pStop, "#") + "% within " + hb, C_FG, "D",
             "Share of stocks bought with no signal at all whose stop at this distance was hit inside the holding period. On 2023-2026 the 18-cell table was within 1.7 points. Between table points the figure is a straight line.")
        r += 1
    f_section(r, "RANGE" + SEP + "close in " + hb)
    r += 1
    f_row(r, "9 in 10", str.tostring(lo05, format.mintick) + " – " + str.tostring(hi95, format.mintick) + SEP + f_signed(f_rOf(lo05)) + " R / " +
         f_signed(f_rOf(hi95)) + " R", C_FG, "D", "The outer lines of the cone: 9 closes in 10 land between them. On 2023-2026 this band held 89.6% to 89.9% of closes. R is measured against the stop: the planned one before the trade, yours once you hold.")
    r += 1
    if full
        f_row(r, "1 in 2", str.tostring(lo25, format.mintick) + " – " + str.tostring(hi75, format.mintick), C_FG, "D",
             "The dotted lines of the cone: half of the closes land between them. On 2023-2026 this band held 48.8% to 50.0% of closes.")
        r += 1
        f_row(r, "This stock", nAud > 0 ? "90%: " + str.tostring(cov90, "#.#") + SEP + "50%: " + str.tostring(cov50, "#.#") + SEP + "stop: " + str.tostring(covStop, "#.#") :
             "not enough history", nAud > 0 and cov90 < 85.0 ? i_cWarn : C_FG, "",
             "The same three figures measured on this symbol's own history (" + str.tostring(nAud, "#") + " windows): how often its 90% band and its middle half held, and how often this stop was hit. Below 85% on the first, the stock jumps more than most.")
        r += 1
    f_section(r, "EVENTS")
    r += 1
    f_row(r, "Earnings", not eKnown ? "no date on file" : "~" + str.tostring(sessToE, "#") + " sessions" + SEP + (eInside ? "INSIDE the period" : "outside the period"),
         eInside ? i_cStop : C_FG, "", "Date from TradingView, read when the script loads. Sessions are estimated from calendar days.")
    r += 1
    if full or eInside
        f_row(r, "Earnings night", "1 in 10 gaps over 2 ATR", eInside ? i_cWarn : C_FG, "U",
             "Opening gap against the holder beyond 1 / 2 / 3 ATR: about " + str.tostring(100.0 * E_GAP1, "#") + "% / " + str.tostring(100.0 * E_GAP2, "#") + "% / " +
             str.tostring(100.0 * E_GAP3, "#") + "% of reports (by year 15-27%, 5-15%, 3-8%). 2 ATR is " + str.tostring(-2.0 / i_stopK, "#.##") +
             " R before the stop can act. That such a night is at least 20 times riskier than an ordinary one is demonstrated; the exact odds are not.")
        r += 1
    f_row(r, "Index", not mktKnown ? "no data" : mktUp ? syminfo.ticker(i_mkt) + " above its 200-day avg" : syminfo.ticker(i_mkt) + " BELOW its 200-day avg",
         mktUp or not mktKnown ? C_FG : i_cWarn, "S",
         "Below its 200-day average the index has been about twice as volatile. It has not meant lower returns, and on 2023-2026 it did not mean more losing stocks.")
    r += 1
    if full or not inUniverse
        f_row(r, "Universe", inUniverse ? "inside" : "OUTSIDE" + SEP + "odds not tested here", inUniverse ? C_FG : i_cWarn, "",
             "The research covered US stocks at 5 dollars or more with a 60-day median of 20 million dollars traded a day. Outside it the odds in this table were not tested.")
        r += 1
    table.cell(tb, 0, r, "D demonstrated" + SEP + "S suggestive" + SEP + "U untested" + SEP + "hover a row", text_halign = text.align_left, text_size = size.tiny,
         text_color = C_MUTED, tooltip = isDaily ? "Daily values, final at the close." : isIntra ? "Daily values of the last completed day." : "Daily values of the last daily bar.")
    table.merge_cells(tb, 0, r, 2, r)

// ─────────────────────────────────────────────────────────────── values for the Data Window, CSV export and the Pine Screener
plot(atrD,      "Daily ATR14",                  display = display.data_window)
plot(100.0 * atrD / closeD, "ATR pct of price", display = display.data_window)
plot(stopPx,    "Stop price",                   display = display.data_window)
plot(shares,    "Shares",                       display = display.data_window)
plot(posPct,    "Position pct of equity",       display = display.data_window)
plot(100.0 * pStop, "Stop odds pct",            display = display.data_window)
plot(lo05,      "Band 5pct",                    display = display.data_window)
plot(lo25,      "Band 25pct",                   display = display.data_window)
plot(hi75,      "Band 75pct",                   display = display.data_window)
plot(hi95,      "Band 95pct",                   display = display.data_window)
plot(cov90,     "Record 90 band pct",           display = display.data_window)
plot(cov50,     "Record 50 band pct",           display = display.data_window)
plot(covStop,   "Record stop hit pct",          display = display.data_window)
plot(nAud,      "Record windows",               display = display.data_window)
plot(dvMed / 1000000.0, "Median dollar volume M", display = display.data_window)
plot(inUniverse ? 1 : 0, "Inside tested universe", display = display.data_window)
plot(sessToE,   "Sessions to earnings",         display = display.data_window)
plot(mktKnown ? (mktUp ? 1 : 0) : na, "Index above 200d", display = display.data_window)
plot(rNow,      "Position R",                   display = display.data_window)
plot(env05,     "Envelope 5pct",                display = display.data_window)
plot(env25,     "Envelope 25pct",               display = display.data_window)
plot(env75,     "Envelope 75pct",               display = display.data_window)
plot(env95,     "Envelope 95pct",               display = display.data_window)
