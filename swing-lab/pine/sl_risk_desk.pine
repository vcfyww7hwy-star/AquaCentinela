//@version=6
// SL Risk Desk  -  swing-lab
// What it answers on any stock chart: how far can this move over my holding period, how many shares is my risk
// budget, how likely is my stop to be hit by noise, is an earnings gap inside my holding window, and is the
// market in its high-risk state.  It gives no buy or sell signal.
//
// Every number comes from research on US stocks (swing-lab/docs/RESEARCH_LOG.md):
//   sigma_daily = 0.757 * ATR(14) / close      best of 30 volatility forecasts tested for the next 5-20 bars
//   range quantiles and stop-out odds          measured on random entries, stable from 1998 to 2018
//   earnings gap odds                          gap worse than -2 ATR: about 10% on the reaction bar, 0.1% otherwise
//   market state                               SPY below its 200-day average: about twice the volatility, same mean
// Status of each claim (development / validated / lockbox) is in the research log; see the playbook.
//
// Non-repainting: on a daily chart values are final at the bar's close; on intraday charts the previous
// completed day is used; alerts are sent once per bar close.
indicator("SL Risk Desk", shorttitle = "SL Risk", overlay = true, max_lines_count = 50, max_labels_count = 50)

// ───────────────────────────── inputs
string G1 = "Your trade"
float  i_equity  = input.float(100000.0, "Account equity", minval = 0.0, group = G1, tooltip = "In the chart's currency.")
float  i_riskPct = input.float(0.75, "Risk per trade, % of equity", minval = 0.05, maxval = 5.0, step = 0.05, group = G1)
float  i_stopK   = input.float(3.0, "Stop distance, in ATR(14)", minval = 0.5, maxval = 6.0, step = 0.25, group = G1,
     tooltip = "Research: stops closer than about 3 ATR lowered the return per bar held; a stop is insurance against the tail, not a source of return.")
int    i_hold    = input.int(10, "Planned holding period, bars", options = [5, 10, 20], group = G1)
float  i_maxPos  = input.float(20.0, "Largest position, % of equity", minval = 1.0, maxval = 100.0, group = G1)

string G2 = "Market state"
string i_mkt     = input.symbol("AMEX:SPY", "Market reference", group = G2)
float  i_dialLow = input.float(50.0, "Exposure when the market is below its 200-day average, %", minval = 0.0, maxval = 100.0, group = G2)

string G3 = "Display"
bool   i_cone    = input.bool(true, "Draw the expected range for the holding period", group = G3)
bool   i_stopLn  = input.bool(true, "Draw the stop level", group = G3)
bool   i_table   = input.bool(true, "Show the table", group = G3)
string i_pos     = input.string("top right", "Table position", options = ["top right", "bottom right", "top left", "bottom left"], group = G3)

// ───────────────────────────── constants from the research (development data; see header)
float SIGMA_PER_ATR = 0.757
// quantiles of  ln(P[t+h] / open[t+1]) / (sigma_daily * sqrt(h))
float Q05 = i_hold == 5 ? -1.53 : i_hold == 10 ? -1.56 : -1.57
float Q25 = i_hold == 5 ? -0.49 : i_hold == 10 ? -0.48 : -0.47
float Q75 = i_hold == 5 ?  0.60 : i_hold == 10 ?  0.64 :  0.69
float Q95 = i_hold == 5 ?  1.45 : i_hold == 10 ?  1.48 :  1.52

// probability that a stop k ATR below the entry is touched within h bars (random entries), k = 1, 1.5, 2, 2.5, 3, 4
f_stopOdds(float k, int h) =>
    array<float> ks = array.from(1.0, 1.5, 2.0, 2.5, 3.0, 4.0)
    array<float> p5  = array.from(0.452, 0.285, 0.175, 0.106, 0.065, 0.027)
    array<float> p10 = array.from(0.594, 0.439, 0.318, 0.226, 0.160, 0.082)
    array<float> p20 = array.from(0.702, 0.574, 0.467, 0.375, 0.298, 0.185)
    array<float> p = h == 5 ? p5 : h == 10 ? p10 : p20
    float kk = math.max(1.0, math.min(4.0, k))
    float res = na
    for i = 0 to 4
        float k0 = ks.get(i)
        float k1 = ks.get(i + 1)
        if kk >= k0 and kk <= k1
            res := p.get(i) + (p.get(i + 1) - p.get(i)) * (kk - k0) / (k1 - k0)
    res

// ───────────────────────────── daily inputs, without repainting
// Daily chart: the chart's own bar, final at its close.  Intraday chart: the previous completed day.
// Weekly or monthly chart: the last daily bar inside the chart bar.
float atrD_prev   = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
float closeD_prev = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
float atrD_last   = request.security(syminfo.tickerid, "D", ta.atr(14))
float closeD_last = request.security(syminfo.tickerid, "D", close)
float atrChart    = ta.atr(14)

float atrD   = timeframe.isdaily ? atrChart : timeframe.isintraday ? atrD_prev : atrD_last
float refD   = timeframe.isdaily ? close    : timeframe.isintraday ? closeD_prev : closeD_last
float sigmaD = SIGMA_PER_ATR * atrD / refD                     // forecast of daily volatility, as a fraction
float sigmaAnn = sigmaD * math.sqrt(252.0) * 100.0

// market state
float mktClose_prev = request.security(i_mkt, "D", close[1], lookahead = barmerge.lookahead_on)
float mktSma_prev   = request.security(i_mkt, "D", ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)
float mktClose_last = request.security(i_mkt, "D", close)
float mktSma_last   = request.security(i_mkt, "D", ta.sma(close, 200))
float mktClose = timeframe.isintraday ? mktClose_prev : mktClose_last
float mktSma   = timeframe.isintraday ? mktSma_prev : mktSma_last
bool  mktUp    = mktClose > mktSma
float dial     = mktUp ? 100.0 : i_dialLow

// ───────────────────────────── the trade
float px       = close
float stopDist = i_stopK * atrD
float stopPx   = px - stopDist
float riskCash = i_equity * i_riskPct / 100.0
float sharesRaw = stopDist > 0 ? riskCash / stopDist : na
float sharesCap = i_equity * i_maxPos / 100.0 / px
float shares   = math.floor(math.min(sharesRaw, sharesCap))
float posValue = shares * px
float posPct   = i_equity > 0 ? 100.0 * posValue / i_equity : na
bool  capped   = sharesRaw > sharesCap
float pStop    = f_stopOdds(i_stopK, i_hold)

// expected range from the current price over the holding period
float sd_h = sigmaD * math.sqrt(i_hold)
float lo05 = px * math.exp(Q05 * sd_h)
float lo25 = px * math.exp(Q25 * sd_h)
float hi75 = px * math.exp(Q75 * sd_h)
float hi95 = px * math.exp(Q95 * sd_h)

// ───────────────────────────── earnings
// earnings.future_time: time of the next scheduled report (fetched when the script loads).
int   nextE     = earnings.future_time
float daysToE   = na(nextE) ? na : (nextE - time_close) / 86400000.0
float sessToE   = na(daysToE) ? na : math.max(0.0, math.round(daysToE * 5.0 / 7.0))     // approximate trading sessions
bool  eInWindow = not na(sessToE) and sessToE <= i_hold
float epsRep    = request.earnings(syminfo.tickerid, earnings.actual, gaps = barmerge.gaps_on, ignore_invalid_symbol = true)
bool  eBar      = not na(epsRep)
int   barsSinceE = ta.barssince(eBar)

// ───────────────────────────── drawings (last bar only)
var line lStop = na
var line l05 = na
var line l25 = na
var line l75 = na
var line l95 = na
var label lbCone = na
if barstate.islast
    line.delete(lStop), line.delete(l05), line.delete(l25), line.delete(l75), line.delete(l95), label.delete(lbCone)
    if i_stopLn
        lStop := line.new(bar_index - 5, stopPx, bar_index + i_hold, stopPx, color = color.new(color.red, 20), style = line.style_dashed, width = 2)
    if i_cone and timeframe.isdaily
        l05 := line.new(bar_index, px, bar_index + i_hold, lo05, color = color.new(color.gray, 30))
        l95 := line.new(bar_index, px, bar_index + i_hold, hi95, color = color.new(color.gray, 30))
        l25 := line.new(bar_index, px, bar_index + i_hold, lo25, color = color.new(color.gray, 55), style = line.style_dotted)
        l75 := line.new(bar_index, px, bar_index + i_hold, hi75, color = color.new(color.gray, 55), style = line.style_dotted)
        lbCone := label.new(bar_index + i_hold, hi95, "90% range in " + str.tostring(i_hold) + " bars", style = label.style_label_left,
             color = color.new(color.gray, 85), textcolor = color.gray, size = size.small)

// ───────────────────────────── table
f_pos(string s) =>
    s == "top right" ? position.top_right : s == "bottom right" ? position.bottom_right : s == "top left" ? position.top_left : position.bottom_left

var table tb = table.new(f_pos(i_pos), 2, 12, border_width = 1, border_color = color.new(color.gray, 70))
f_row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_halign = text.align_left, text_size = size.small, text_color = color.gray)
    table.cell(tb, 1, r, v, text_halign = text.align_right, text_size = size.small, text_color = c)

if barstate.islast and i_table
    color cOk = chart.fg_color
    color cWarn = color.orange
    color cBad = color.red
    f_row(0, "Volatility forecast", str.tostring(sigmaD * 100.0, "#.##") + "% a day  (" + str.tostring(sigmaAnn, "#") + "% a year)", cOk)
    f_row(1, "ATR(14), daily", str.tostring(atrD, format.mintick) + "  (" + str.tostring(100.0 * atrD / refD, "#.##") + "%)", cOk)
    f_row(2, "90% range, " + str.tostring(i_hold) + " bars", str.tostring(lo05, format.mintick) + "  to  " + str.tostring(hi95, format.mintick), cOk)
    f_row(3, "Middle half", str.tostring(lo25, format.mintick) + "  to  " + str.tostring(hi75, format.mintick), cOk)
    f_row(4, "Stop  (" + str.tostring(i_stopK, "#.##") + " ATR)", str.tostring(stopPx, format.mintick) + "   -" + str.tostring(100.0 * stopDist / px, "#.#") + "%", cOk)
    f_row(5, "Shares for " + str.tostring(i_riskPct, "#.##") + "% risk", str.tostring(shares, "#") + (capped ? "  (capped)" : ""), capped ? cWarn : cOk)
    f_row(6, "Position", str.tostring(posValue, "#") + "   " + str.tostring(posPct, "#.#") + "% of equity", cOk)
    f_row(7, "Stop hit by noise, " + str.tostring(i_hold) + " bars", str.tostring(100.0 * pStop, "#") + "% of random entries", pStop > 0.35 ? cWarn : cOk)
    string eTxt = na(sessToE) ? "no date" : "in about " + str.tostring(sessToE, "#") + " sessions"
    f_row(8, "Next earnings", eTxt, eInWindow ? cBad : cOk)
    f_row(9, "Earnings inside the hold", eInWindow ? "YES: gap beyond -2 ATR about 1 in 10" : "no", eInWindow ? cBad : cOk)
    f_row(10, "Market (" + syminfo.ticker(i_mkt) + " vs 200-day)", mktUp ? "above: normal risk" : "below: about twice the risk", mktUp ? cOk : cBad)
    f_row(11, "Suggested exposure", str.tostring(dial, "#") + "% of normal", mktUp ? cOk : cWarn)

// ───────────────────────────── plots for the Data Window, the Pine Screener and parity checks
plot(sigmaD * 100.0, "Volatility forecast, % a day", display = display.data_window)
plot(sigmaAnn, "Volatility forecast, % a year", display = display.data_window)
plot(atrD, "ATR(14) daily", display = display.data_window)
plot(stopPx, "Stop price", display = display.data_window)
plot(shares, "Shares", display = display.data_window)
plot(100.0 * pStop, "Stop-out odds, %", display = display.data_window)
plot(lo05, "Range 5%", display = display.data_window)
plot(hi95, "Range 95%", display = display.data_window)
plot(sessToE, "Sessions to earnings", display = display.data_window)
plot(mktUp ? 1 : 0, "Market above 200-day", display = display.data_window)
plot(barsSinceE, "Bars since earnings", display = display.data_window)

// ───────────────────────────── alerts (one technical alert carries them all)
bool mktFlip = mktUp != mktUp[1] and not na(mktSma[1])
if barstate.isconfirmed
    if mktFlip
        alert("Market state changed: " + syminfo.ticker(i_mkt) + (mktUp ? " closed above" : " closed below") + " its 200-day average. Suggested exposure " + str.tostring(dial, "#") + "%.", alert.freq_once_per_bar_close)
    if eInWindow and not eInWindow[1]
        alert(syminfo.ticker + ": earnings in about " + str.tostring(sessToE, "#") + " sessions, inside a " + str.tostring(i_hold) + "-bar hold. A gap beyond -2 ATR happens about 1 time in 10 on the report.", alert.freq_once_per_bar_close)
alertcondition(mktFlip, "Market state changed", "Market reference crossed its 200-day average")
alertcondition(eInWindow and not eInWindow[1], "Earnings inside the holding window", "Earnings are now inside the planned holding period")
